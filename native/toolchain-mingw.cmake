# Windows cross-build with llvm-mingw (https://github.com/mstorsjo/llvm-mingw). Root from $MINGW or -DLLVM_MINGW=.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{MINGW})
	set(LLVM_MINGW "$ENV{MINGW}" CACHE PATH "")
endif()
if(NOT LLVM_MINGW)
	message(FATAL_ERROR "Defina MINGW (raiz do llvm-mingw) ou -DLLVM_MINGW=...")
endif()
if(CMAKE_HOST_WIN32)
	set(TOOL_SUFFIX ".exe")
else()
	set(TOOL_SUFFIX "")
endif()
set(CMAKE_C_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang${TOOL_SUFFIX}")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++${TOOL_SUFFIX}")
set(CMAKE_RC_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-windres${TOOL_SUFFIX}")
set(CMAKE_AR "${LLVM_MINGW}/bin/llvm-ar${TOOL_SUFFIX}")
set(CMAKE_RANLIB "${LLVM_MINGW}/bin/llvm-ranlib${TOOL_SUFFIX}")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
