{
  "_doc": "Reference photos of the Roadcraft 4.0's interface: the title screen, the top bar, every popover, the drawers with their tool options, the dialogs. The small city, seed 7.",
  "viewport": [1600, 900],
  "city": { "size": "small", "seed": 7 },
  "steps": [
    { "wait": 1500 },
    { "shot": "start" },
    { "press": "Começar a construir" },
    { "until": "(() => !document.querySelector('.v2-start'))()", "name": "title closed", "timeout": 30000, "polling": 250 },
    { "eval": "window.__roadcraft.sim.setClock(720); window.__roadcraft.scene().setSkyMode('day'); 1" },
    { "lookAt": [0, 0, 0.35] }, { "wait": 3000 },
    { "shot": "hud" },
    { "eval": "document.querySelector('[title=\"Menu\"], .v2-actions .v2-pill:last-child').click(); 1" }, { "wait": 400 },
    { "shot": "pop-menu" },
    { "key": "Escape" }, { "wait": 200 },
    { "eval": "document.querySelectorAll('.v2-actions .v2-pill')[0].click(); 1" }, { "wait": 400 },
    { "shot": "pop-layers" },
    { "key": "Escape" }, { "wait": 200 },
    { "eval": "document.querySelectorAll('.v2-actions .v2-pill')[1].click(); 1" }, { "wait": 400 },
    { "shot": "pop-sim" },
    { "key": "Escape" }, { "wait": 200 },
    { "eval": "document.querySelectorAll('.v2-actions .v2-pill')[2].click(); 1" }, { "wait": 400 },
    { "shot": "pop-camera" },
    { "key": "Escape" }, { "wait": 200 },
    { "eval": "[...document.querySelectorAll('.v2-actions .v2-icon')].slice(-1)[0].click(); 1" }, { "wait": 400 },
    { "shot": "pop-help" },
    { "key": "Escape" }, { "wait": 200 },
    { "eval": "document.querySelector('[data-cat=roads]').click(); 1" }, { "wait": 800 },
    { "shot": "drawer-roads" },
    { "eval": "document.querySelector('[data-cat=zones]').click(); 1" }, { "wait": 800 },
    { "shot": "drawer-zones" },
    { "eval": "document.querySelector('[data-cat=landscape]').click(); 1" }, { "wait": 800 },
    { "shot": "drawer-landscape" },
    { "eval": "document.querySelector('[data-cat=demolish]').click(); 1" }, { "wait": 800 },
    { "shot": "drawer-demolish" },
    { "eval": "document.querySelector('[data-cat=demolish]').click(); 1" }, { "wait": 300 },
    { "eval": "document.querySelector('.v2-actions .v2-pill:last-child').click(); 1" }, { "wait": 300 },
    { "press": "Opções gráficas", "optional": true }, { "wait": 500 },
    { "shot": "dialog-graphics" },
    { "key": "Escape" }, { "wait": 300 },
    { "eval": "document.querySelector('.v2-actions .v2-pill:last-child').click(); 1" }, { "wait": 300 },
    { "press": "Sobre", "optional": true }, { "wait": 500 },
    { "shot": "dialog-about" },
    { "key": "Escape" }, { "wait": 300 },
    { "key": "F9" }, { "wait": 700 },
    { "shot": "panel-health" },
    { "key": "Escape" }, { "wait": 300 }
  ]
}
