{
  "_doc": "Proposta para fonte/.claude/settings.json (só o usuário altera esse arquivo: o hook hook_protect.py nega a edição e o CLAUDE.md diz o mesmo). Diferenças para o arquivo atual: (1) o hook de Stop ganha `stop_hook_active` respeitado como hoje; (2) acrescenta SessionStart (matcher compact|resume|startup) reinjetando o checkpoint e a cobertura de leitura, para que uma compactação não perca o contexto; (3) acrescenta PostToolUse em Read|Bash|PowerShell|WebFetch com o registro de leitura; (4) acrescenta PreCompact com o checkpoint. Os itens 2 a 4 já estão em ~/.claude/settings.json (escopo do usuário) e valem para fonte e clones; ficam aqui para o dia em que o repositório for clonado por outra pessoa ou o settings do usuário for limpo. Para aplicar: copie este objeto por cima do atual, sem o campo _doc.",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": ["Bash", "PowerShell", "Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Agent", "Workflow",
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)", "Bash(git clean *)", "Bash(git stash drop *)", "Bash(git stash clear *)",
      "Bash(git branch -D *)", "Bash(git checkout -- *)", "Bash(git restore *)",
      "Edit(tools/gates/rules.json)", "Edit(tools/gates/owners.json)", "Edit(tools/gates/run_gates.py)",
      "Edit(tools/gates/gate_*.py)", "Edit(tools/gates/hook_*.py)", "Edit(.claude/settings.json)", "Edit(.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["C:/Projects/Roadcraft-windows/tools/reading/inventory.py", "contexto"], "timeout": 20}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["${CLAUDE_PROJECT_DIR}/tools/gates/hook_protect.py"], "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell|WebFetch",
        "hooks": [
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["C:/Projects/Roadcraft-windows/tools/reading/inventory.py", "hook"], "timeout": 20}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["C:/Projects/Roadcraft-windows/tools/reading/inventory.py", "checkpoint"], "timeout": 20}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["${CLAUDE_PROJECT_DIR}/tools/gates/hook_stop_gates.py"], "timeout": 60},
          {"type": "command", "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
           "args": ["C:/Projects/Roadcraft-windows/tools/reading/inventory.py", "checkpoint"], "timeout": 20}
        ]
      }
    ]
  }
}
