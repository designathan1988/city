   "text": "low: {\n    pixelRatio: 1,\n    shadows: false,\n    shadowMapSize: 1024,\n    postProcessing: false,\n    ambientOcclusion: false,\n    smaa: false,\n    msaa: 0,\n    aoFull: false,\n    sharpen: 0,\n    anisotropy: 2,\n    detailProps: false,\n    vegetation: 0,\n    grassBlades: 0,\n    surfaceDetail: false,\n    detailCutoffZoom: perM(1.25),\n    pedestrianDetail: 0,\n    occupantZoom: perM(7.5),\n    // The weak machine's integrated GPU: parts a pixel off, fewer whole vehicles, strands on the two nearest (the other tiers draw as they always did).\n    vehicleErrorPixels: 1,\n    vehicleWholeCap: 60,\n    hairStrandPeople: 2,\n    cloudShadows: false,\n    vegetationDistance: m(180),\n    impostors: true,\n    birds: 0,\n    rain: false,\n    skyClouds: false,\n    mist: false,\n    waterfalls: false,\n    triangleScale: 0.35,\n    detailMemoryMB: 256,\n  }"
  },
  {
