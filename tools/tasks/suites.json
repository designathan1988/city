{
 "_doc": "The support tools' work as data, run by tools/tasks/cli.py (schema: tools/gates/schemas/suites.schema.json). A task is a process with its own deadline (timeout_s), the inputs and extra strings that key its result, the outputs restored on a cache hit, the tasks it runs after, its resources and its verdict. {name} is a var (vars, versions, or the built-in root, python); an inputs element @name is a set; a suite element @name is a group or another suite; an argv element {changed_list:--files-from} expands to --files-from and a file listing the changed files (the task is dropped when none changed) and {changed} in inputs to the changed files; {loads} in inputs is every file the Godot run of the task's argv may load (tools/tasks/godot_deps.py: the scene, the plan, the project settings, the extensions, and every script, scene, shader, table and asset they reach), and such a run is --verbose so its verdict fails on a resource it loaded outside them. Every Godot task loads the debug DLL: it runs after build_debug, whose output that DLL is, and the DLL is among what it loads (bin/citycore.gdextension), so a scene reruns exactly when what it loads changed. capacity counts what cores do not: `godot` is a Godot process with a city in it, which takes gigabytes of memory and the machine's one GPU whatever its share of processors, so at most that many run at once (six at once took 85% of the memory and 76% of the GPU on 2026-11-10).",
 "vars": {
  "test_fps": {
   "doc": "the tests' simulated time: each frame moves the game 1/test_fps s (Godot --fixed-fps, real-time synchronisation off) and frames run uncapped (--disable-vsync, --max-fps 0, Settings keeps no cap under it): a test takes the time its work takes, never 16.7 ms a frame; a test that measures real frame times sets -1 (wall time) on its item",
   "windows": "60",
   "posix": "60"
  },
  "godot": {"doc": "Godot 4.7 console binary (GODOT, tools/tasks/local.json or the PATH: tools/tasks/locations.py)", "locate": "godot"},
  "bash": {"doc": "the bash that runs tools/build/*.sh: Git for Windows' own, found beside its git, never the WSL one in System32 (BASH_EXE)", "locate": "bash"},
  "mingw": {"doc": "llvm-mingw root of the Windows build (MINGW, or the folder above its x86_64-w64-mingw32-clang++)", "locate": "mingw"},
  "captures": {
   "doc": "where the capture suite writes, one folder per task (tools/build/build.sh capture DIR sets it)",
   "env": "CAPTURE_DIR",
   "windows": "{root}/dist/captures",
   "posix": "{root}/dist/captures"
  }
 },
 "versions": {
  "godot_version": {"doc": "the Godot that runs the scenes", "argv": ["{godot}", "--headless", "--version"]},
  "cmake_version": {"doc": "the CMake that configures the core's build", "argv": ["cmake", "--version"]},
  "ninja_version": {"doc": "the Ninja that runs the core's build", "argv": ["ninja", "--version"]},
  "clang_version": {"doc": "the compiler of the Windows DLLs (llvm-mingw)", "argv": ["{mingw}/bin/clang++", "--version"]}
 },
 "loads": {"doc": "{loads}: the C++ folders whose res:// paths the loaded core library opens", "native": ["native/src"]},
 "capacity": {"godot": 2},
 "changed": {
  "doc": "the changed files the gates look at (run_gates.py --files-from: a path outside every gate is reported and skipped there)",
  "include": ["**"],
  "exclude": ["log/**"]
 },
 "sets": {
  "project": ["project/**", "!@release_libraries"],
  "release_libraries": ["project/bin/libcitycore.windows.template_release.x86_64.dll", "project/bin/*.so"],
  "native": ["native/**"]
 },
 "tasks": {
  "import": {
   "doc": "Godot's import: a class new to the project is known only after it",
   "argv": ["{godot}", "--headless", "--path", "project", "--import"],
   "timeout_s": 600,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "outputs": ["project/.godot/global_script_class_cache.cfg", "project/.godot/uid_cache.bin"],
   "resources": {"cores": 2, "locks": {"dll": "shared"}}
  },
  "scripts": {
   "doc": "every GDScript compiles (tools/build/check_scripts.gd); a scene whose script does not parse never quits, so the scenes run after this",
   "argv": ["{godot}", "--headless", "--path", "project", "-s", "{root}/tools/build/check_scripts.gd"],
   "timeout_s": 300,
   "inputs": ["@project", "tools/build/check_scripts.gd"],
   "extra": ["{godot_version}"],
   "after": ["import"],
   "resources": {"cores": 2, "locks": {"dll": "shared"}}
  },
  "build_debug": {
   "doc": "the debug DLL, the one the editor, tests and captures load",
   "argv": ["{bash}", "tools/build/build.sh", "dll-debug"],
   "timeout_s": 3600,
   "inputs": ["@native", "tools/build/build.sh", "tools/build/free_dll.sh"],
   "extra": ["{cmake_version}", "{ninja_version}", "{clang_version}"],
   "env": {"MINGW": "{mingw}"},
   "outputs": ["project/bin/libcitycore.windows.template_debug.x86_64.dll"],
   "verdict": "no_machine_path",
   "resources": {"cores": "all", "locks": {"dll": "exclusive"}}
  },
  "build_release": {
   "doc": "the release DLL, the one the export ships",
   "argv": ["{bash}", "tools/build/build.sh", "dll-release"],
   "timeout_s": 3600,
   "inputs": ["@native", "tools/build/build.sh", "tools/build/free_dll.sh"],
   "extra": ["{cmake_version}", "{ninja_version}", "{clang_version}"],
   "env": {"MINGW": "{mingw}"},
   "outputs": ["project/bin/libcitycore.windows.template_release.x86_64.dll"],
   "verdict": "no_machine_path",
   "resources": {"cores": "all", "locks": {"dll": "exclusive"}}
  },
  "gates_changed": {
   "doc": "the gates on the changed files, handed over as a list file (run_gates.py --files-from: any number of paths fits); a gate may compare a file with any other, so the whole tree keys the result",
   "argv": ["{python}", "tools/gates/run_gates.py", "{changed_list:--files-from}"],
   "timeout_s": 600,
   "inputs": ["**"],
   "resources": {"cores": 2}
  },
  "gates_all": {
   "doc": "every gate on the whole tree",
   "argv": ["{python}", "tools/gates/run_gates.py"],
   "timeout_s": 1200,
   "inputs": ["**"],
   "resources": {"cores": 2}
  },
  "digest": {
   "doc": "a fixed city hashed (open_probe --digest) and held to its golden: an optimisation leaves it equal",
   "argv": ["{godot}", "--verbose", "--headless", "--path", "project", "res://tests/perf/open_probe.tscn", "--", "--no-flow", "--digest"],
   "timeout_s": 600,
   "inputs": ["{loads}", "!@release_libraries", "dist/quick/golden.txt"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "verdict": "matches_golden",
   "params": {"line": "^DIGEST ", "golden": "dist/quick/golden.txt"},
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}},
   "hint": "a change meant to move the digest: run with --bless"
  },
  "digest_bless": {
   "doc": "--bless: the digest of this run becomes the golden",
   "argv": ["{godot}", "--verbose", "--headless", "--path", "project", "res://tests/perf/open_probe.tscn", "--", "--no-flow", "--digest"],
   "timeout_s": 600,
   "inputs": ["{loads}", "!@release_libraries"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["dist/quick/golden.txt"],
   "verdict": "write_golden",
   "params": {"line": "^DIGEST ", "golden": "dist/quick/golden.txt"},
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}}
  },
  "photos": {
   "doc": "the still world photographed frozen (look --frozen: no clock, no TIME, waits by frames)",
   "argv": [
    "{godot}",
    "--verbose",
    "--path",
    "project",
    "--resolution",
    "1280x720",
    "res://tests/visual/look.tscn",
    "--",
    "--no-flow",
    "--frozen",
    "--plan=res://tests/visual/frozen_plan.json",
    "--capture-dir={root}/dist/quick/photos"
   ],
   "timeout_s": 90,
   "hidden": true,
   "inputs": ["{loads}", "!@release_libraries"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["dist/quick/photos"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}}
  },
  "photos_check": {
   "doc": "where the frozen photos differ from a kept set (photos_bless), run by name only: a help to find where to look, never a verdict on the game and in no suite (a photo is judged on its own; two runs of the same code differ in pixels)",
   "argv": ["{python}", "tools/build/photodiff.py", "dist/quick/golden_photos", "dist/quick/photos", "dist/quick/photos_diff"],
   "timeout_s": 120,
   "inputs": ["dist/quick/golden_photos", "dist/quick/photos", "tools/build/photodiff.py"],
   "after": ["photos"],
   "outputs": ["dist/quick/photos_diff"],
   "fresh": true,
   "hint": "look at this run's photos (dist/quick/photos): only what is wrong in them is a finding"
  },
  "photos_bless": {
   "doc": "the photos of this run kept as the set photos_check compares with, run by name only",
   "call": "tasks.steps:copy",
   "spec": {"from": "dist/quick/photos", "to": "dist/quick/golden_photos"},
   "timeout_s": 120,
   "inputs": ["dist/quick/photos"],
   "after": ["photos"],
   "outputs": ["dist/quick/golden_photos"]
  }
 },
 "templates": {
  "godot_test": {
   "argv": [
    "{godot}",
    "--verbose",
    "--path",
    "project",
    "--rendering-method",
    "{renderer}",
    "--fixed-fps",
    "{test_fps}",
    "--disable-vsync",
    "--max-fps",
    "0",
    "res://{scene}.tscn",
    "--",
    "--no-flow"
   ],
   "hidden": true,
   "inputs": ["{loads}", "!@release_libraries"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "verdict": "godot",
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}}
  },
  "look": {
   "argv": [
    "{godot}",
    "--verbose",
    "--path",
    "project",
    "--resolution",
    "{resolution}",
    "res://tests/visual/look.tscn",
    "--",
    "--no-flow",
    "--plan={plan}",
    "--capture-dir={captures}/{name}"
   ],
   "hidden": true,
   "inputs": ["{loads}", "!@release_libraries"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["{captures}/{name}"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}}
  },
  "capture_scene": {
   "argv": [
    "{godot}",
    "--verbose",
    "--path",
    "project",
    "--resolution",
    "{resolution}",
    "res://{scene}.tscn",
    "--",
    "--no-flow",
    "--capture-dir={captures}/{name}"
   ],
   "hidden": true,
   "inputs": ["{loads}", "!@release_libraries"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["{captures}/{name}"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "godot": 1, "locks": {"dll": "shared"}}
  }
 },
