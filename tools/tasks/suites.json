{
 "_doc": "The support tools' work as data, run by tools/tasks/cli.py (schema: tools/gates/schemas/suites.schema.json). A task is a process with its own deadline (timeout_s), the inputs and extra strings that key its result, the outputs restored on a cache hit, the tasks it runs after, its resources and its verdict. {name} is a var (vars, or the built-in root, python, godot_version); an inputs element @name is a set; a suite element @name is a group or another suite; an argv element {changed_list:--files-from} expands to --files-from and a file listing the changed files (the task is dropped when none changed) and {changed} in inputs to the changed files. Every Godot task loads the debug DLL: it runs after build_debug, whose output that DLL is, and the DLL is among its inputs (the project set), so a scene reruns exactly when what it loads changed.",
 "vars": {
  "godot": {
   "doc": "Godot 4.7 console binary",
   "env": "GODOT",
   "windows": "C:/Users/Jonathan/AppData/Local/Microsoft/WinGet/Links/godot_console.exe",
   "posix": "godot"
  },
  "bash": {
   "doc": "the bash that runs tools/build/*.sh (Git Bash on Windows, never the WSL one in System32)",
   "env": "BASH_EXE",
   "windows": "C:/Program Files/Git/bin/bash.exe",
   "posix": "bash"
  },
  "mingw": {
   "doc": "llvm-mingw root of the Windows build",
   "env": "MINGW",
   "windows": "C:/Projects/toolchains/llvm-mingw-20261020-ucrt-x86_64",
   "posix": ""
  },
  "captures": {
   "doc": "where the capture suite writes, one folder per task (tools/build/build.sh capture DIR sets it)",
   "env": "CAPTURE_DIR",
   "windows": "{root}/dist/captures",
   "posix": "{root}/dist/captures"
  }
 },
 "changed": {
  "doc": "the changed files the gates look at (run_gates.py --files-from: a path outside every gate is reported and skipped there)",
  "include": ["**"],
  "exclude": ["log/**"]
 },
 "sets": {
  "project": ["project/**", "!project/bin/libcitycore.windows.template_release.x86_64.dll", "!project/bin/*.so"],
  "native": ["native/**"]
 },
 "tasks": {
  "import": {
   "doc": "Godot's import: a class new to the project is known only after it",
   "argv": ["{godot}", "--headless", "--path", "project", "--import"],
   "timeout_s": 600,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "outputs": ["project/.godot/global_script_class_cache.cfg", "project/.godot/uid_cache.bin"],
   "resources": {"cores": 2, "locks": {"dll": "shared"}}
  },
  "scripts": {
   "doc": "every GDScript compiles (tools/build/check_scripts.gd); a scene whose script does not parse never quits, so the scenes run after this",
   "argv": ["{godot}", "--headless", "--path", "project", "-s", "{root}/tools/build/check_scripts.gd"],
   "timeout_s": 300,
   "inputs": ["@project", "tools/build/check_scripts.gd"],
   "extra": ["{godot_version}"],
   "after": ["import"],
   "resources": {"cores": 2, "locks": {"dll": "shared"}}
  },
  "build_debug": {
   "doc": "the debug DLL, the one the editor, tests and captures load",
   "argv": ["{bash}", "tools/build/build.sh", "dll-debug"],
   "timeout_s": 3600,
   "inputs": ["@native", "tools/build/build.sh", "tools/build/free_dll.sh"],
   "env": {"MINGW": "{mingw}"},
   "outputs": ["project/bin/libcitycore.windows.template_debug.x86_64.dll"],
   "resources": {"cores": "all", "locks": {"dll": "exclusive"}}
  },
  "build_release": {
   "doc": "the release DLL, the one the export ships",
   "argv": ["{bash}", "tools/build/build.sh", "dll-release"],
   "timeout_s": 3600,
   "inputs": ["@native", "tools/build/build.sh", "tools/build/free_dll.sh"],
   "env": {"MINGW": "{mingw}"},
   "outputs": ["project/bin/libcitycore.windows.template_release.x86_64.dll"],
   "resources": {"cores": "all", "locks": {"dll": "exclusive"}}
  },
  "gates_changed": {
   "doc": "the gates on the changed files, handed over as a list file (run_gates.py --files-from: any number of paths fits); a gate may compare a file with any other, so the whole tree keys the result",
   "argv": ["{python}", "tools/gates/run_gates.py", "{changed_list:--files-from}"],
   "timeout_s": 600,
   "inputs": ["**"],
   "resources": {"cores": 2}
  },
  "gates_all": {
   "doc": "every gate on the whole tree",
   "argv": ["{python}", "tools/gates/run_gates.py"],
   "timeout_s": 1200,
   "inputs": ["**"],
   "resources": {"cores": 2}
  },
  "digest": {
   "doc": "a fixed city hashed (open_probe --digest) and held to its golden: an optimisation leaves it equal",
   "argv": ["{godot}", "--headless", "--path", "project", "res://tests/perf/open_probe.tscn", "--", "--no-flow", "--digest"],
   "timeout_s": 600,
   "inputs": ["@project", "dist/quick/golden.txt"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "verdict": "matches_golden",
   "params": {"line": "^DIGEST ", "golden": "dist/quick/golden.txt"},
   "resources": {"cores": 3, "locks": {"dll": "shared"}},
   "hint": "a change meant to move the digest: run with --bless"
  },
  "digest_bless": {
   "doc": "--bless: the digest of this run becomes the golden",
   "argv": ["{godot}", "--headless", "--path", "project", "res://tests/perf/open_probe.tscn", "--", "--no-flow", "--digest"],
   "timeout_s": 600,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["dist/quick/golden.txt"],
   "verdict": "write_golden",
   "params": {"line": "^DIGEST ", "golden": "dist/quick/golden.txt"},
   "resources": {"cores": 3, "locks": {"dll": "shared"}}
  },
  "photos": {
   "doc": "the still world photographed frozen (look --frozen: no clock, no TIME, waits by frames)",
   "argv": [
    "{godot}",
    "--path",
    "project",
    "--resolution",
    "1280x720",
    "res://tests/visual/look.tscn",
    "--",
    "--no-flow",
    "--frozen",
    "--plan=res://tests/visual/frozen_plan.json",
    "--capture-dir={root}/dist/quick/photos"
   ],
   "timeout_s": 90,
   "hidden": true,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["dist/quick/photos"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "locks": {"dll": "shared"}}
  },
  "photos_check": {
   "doc": "the frozen photos against their golden, bit for bit",
   "argv": ["{python}", "tools/build/photodiff.py", "dist/quick/golden_photos", "dist/quick/photos", "dist/quick/photos_diff"],
   "timeout_s": 120,
   "inputs": ["dist/quick/golden_photos", "dist/quick/photos", "tools/build/photodiff.py"],
   "after": ["photos"],
   "outputs": ["dist/quick/photos_diff"],
   "fresh": true,
   "hint": "a change meant to move the photos: run with --bless"
  },
  "photos_bless": {
   "doc": "--bless: the photos of this run become the golden",
   "call": "tasks.steps:copy",
   "spec": {"from": "dist/quick/photos", "to": "dist/quick/golden_photos"},
   "timeout_s": 120,
   "inputs": ["dist/quick/photos"],
   "after": ["photos"],
   "outputs": ["dist/quick/golden_photos"]
  }
 },
 "templates": {
  "godot_test": {
   "argv": ["{godot}", "--path", "project", "--rendering-method", "{renderer}", "res://{scene}.tscn", "--", "--no-flow"],
   "hidden": true,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "verdict": "godot",
   "resources": {"cores": 3, "locks": {"dll": "shared"}}
  },
  "look": {
   "argv": [
    "{godot}",
    "--path",
    "project",
    "--resolution",
    "{resolution}",
    "res://tests/visual/look.tscn",
    "--",
    "--no-flow",
    "--plan={plan}",
    "--capture-dir={captures}/{name}"
   ],
   "hidden": true,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["{captures}/{name}"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "locks": {"dll": "shared"}}
  },
  "capture_scene": {
   "argv": [
    "{godot}",
    "--path",
    "project",
    "--resolution",
    "{resolution}",
    "res://{scene}.tscn",
    "--",
    "--no-flow",
    "--capture-dir={captures}/{name}"
   ],
   "hidden": true,
   "inputs": ["@project"],
   "extra": ["{godot_version}"],
   "after": ["build_debug", "import", "scripts"],
   "outputs": ["{captures}/{name}"],
   "fresh": true,
   "verdict": "godot",
   "resources": {"cores": 3, "locks": {"dll": "shared"}}
  }
 },
 "groups": {
  "test_scenes": {
