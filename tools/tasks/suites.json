  },
  "looks": {
   "doc": "the look plans the capture suite photographs",
   "template": "look",
   "items": [{"name": "frozen", "plan": "res://tests/visual/frozen_plan.json", "resolution": "1280x720", "timeout_s": 90},
    {"name": "sao_paulo", "plan": "res://tests/visual/sao_paulo_plan.json", "resolution": "1600x900", "timeout_s": 900}]
  },
  "capture_scenes": {
   "doc": "the reference views (capture.tscn: street from above, neighbourhood, whole town)",
   "template": "capture_scene",
   "items": [{"name": "city", "scene": "tests/visual/capture", "resolution": "1600x900", "timeout_s": 1800}]
  }
 },
 "suites": {
  "quick": {
   "doc": "what a change asks for: scripts, debug DLL, gates of the changed files, every scene whose inputs moved, the digest and the frozen photos against their goldens",
   "tasks": ["import", "scripts", "build_debug", "gates_changed", "@test_scenes", "digest", "photos", "photos_check"],
   "variants": {
    "ready": {
     "doc": "the check before a commit: also the release DLL; when all of it holds it leaves dist/quick/passed",
     "add": ["build_release"],
     "stamp": "dist/quick/passed"
    },
    "all": {"doc": "the full run: also the release DLL, and nothing taken from the cache", "add": ["build_release"]},
    "bless": {
     "doc": "the digest and the frozen photos of this run become the goldens (only with a visual change that is understood)",
     "swap": {"digest": "digest_bless", "photos_check": "photos_bless"}
    }
   }
  },
  "ready": {"doc": "quick --ready", "tasks": ["@quick"], "apply": ["ready"]},
  "fast": {"doc": "the iteration loop: scripts, then the debug DLL", "tasks": ["scripts", "build_debug"]},
  "tests": {"doc": "every test scene", "tasks": ["@test_scenes"]},
  "capture": {
   "doc": "the capture views, each a hidden --no-flow task with its own deadline",
   "tasks": ["@looks", "@capture_scenes"]
  },
  "gates": {"doc": "every gate", "tasks": ["gates_all"]}
 }
}
