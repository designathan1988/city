{
  "description": "The contracts of CLAUDE.md and their guards (tools/gates/contracts.json, read by gate_contracts.py): each rule an id marked [c:<id>] in CLAUDE.md, each with the mechanisms that keep it.",
  "type": "object",
  "strict": true,
  "properties": {
    "_doc": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "contracts": {
      "type": "array", "minItems": 1, "unique_key": "id",
      "items": {
        "type": "object", "strict": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "rule": {"type": "string", "minLength": 1},
          "guards": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "strict": true,
              "properties": {
                "kind": {"enum": ["gate", "test", "tool", "hook", "runtime", "conduct"]},
                "name": {"type": "string", "minLength": 1},
                "why": {"type": "string", "minLength": 1}
              },
              "required": ["kind", "name"]
            }
          }
        },
        "required": ["id", "rule", "guards"]
      }
    }
  },
  "required": ["sections", "contracts"]
}
