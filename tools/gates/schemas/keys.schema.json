{
 "$defs": {
  "tool": {"type": "string", "enum": ["roads", "zones", "build", "landscape", "transit", "demolish", "info"]}
 },
 "type": "object",
 "strict": true,
 "required": ["_doc", "rules", "tools", "tabs", "digit_keys", "terrain"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "rules": {"type": "array", "minItems": 1,
            "items": {"type": "object", "strict": true, "required": ["key", "action"],
                      "properties": {"key": {"type": "string", "minLength": 1}, "action": {"type": "string", "pattern": "^[a-z_]+$"},
                                     "ctrl": {"type": "boolean"}, "shift": {"type": "boolean"}}}},
  "tools": {"type": "object", "additional": {"$ref": "#/$defs/tool"}},
  "tabs": {"type": "object", "additional": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/tool"}, {"type": "string", "pattern": "^[a-z_]+$"}]}},
  "digit_keys": {"type": "string", "pattern": "^[0-9]+$"},
  "terrain": {"type": "object",
              "additional": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"type": "string", "enum": ["radius", "strength"]}, {"type": "integer", "enum": [-1, 1]}]}}
 }
}
