{
 "$defs": {
  "hex": {"type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},
  "hexes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}},
  "value": {"description": "a uniform's value as render/city_world.gd shader_value reads it; gate_materials.py checks each key against terrain.gdshader",
            "oneOf": [{"type": "number"}, {"type": "boolean"},
                      {"type": "string", "pattern": "^(res://.+|#([0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"},
                      {"type": "array", "minItems": 1, "items": {"type": "number"}},
                      {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}}]}
 },
 "type": "object",
 "strict": true,
 "required": ["vehicle_tints", "person_tints", "foliage_round", "water", "sky", "terrain"],
 "properties": {
  "vehicle_tints": {"$ref": "#/$defs/hexes"},
  "person_tints": {"$ref": "#/$defs/hexes"},
  "foliage_round": {"$ref": "#/$defs/hexes"},
  "water": {
   "type": "object", "strict": true,
   "required": ["shallow", "deep", "sea_level_m", "wave_scale", "peak_hz", "detail_ratio", "ripple_strength", "slope_sigma", "specular_f0", "fetch_m"],
   "properties": {
    "_doc": {"type": "string"},
    "shallow": {"$ref": "#/$defs/hex"}, "mid": {"$ref": "#/$defs/hex"}, "deep": {"$ref": "#/$defs/hex"}, "foam_tint": {"$ref": "#/$defs/hex"},
    "gravel": {"$ref": "#/$defs/hex"}, "silt": {"$ref": "#/$defs/hex"},
    "sea_level_m": {"type": "number"}, "wave_scale": {"type": "number", "minimum": 0}, "peak_hz": {"type": "number", "exclusiveMinimum": 0},
    "detail_ratio": {"type": "number", "minimum": 0}, "ripple_strength": {"type": "number", "minimum": 0}, "slope_sigma": {"type": "number", "minimum": 0},
    "specular_f0": {"type": "number", "minimum": 0, "maximum": 1}, "fetch_m": {"type": "number", "exclusiveMinimum": 0},
    "tint_depth_m": {"type": "number", "exclusiveMinimum": 0}, "slick_share": {"type": "number", "minimum": 0, "maximum": 1},
    "foam_m": {"type": "number", "minimum": 0}, "rim_m": {"type": "number", "minimum": 0}, "bed_from_m": {"type": "number", "minimum": 0},
    "silt_m": {"type": "number", "minimum": 0}, "bed_cover": {"type": "number", "minimum": 0, "maximum": 1},
    "absorb_m": {"type": "array", "minItems": 3, "items": false, "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}]},
    "bed_wet": {"type": "number", "minimum": 0, "maximum": 1}, "bed_seen_m": {"type": "number", "minimum": 0}, "bed_hidden_m": {"type": "number", "minimum": 0},
    "sheet_least": {"type": "number", "minimum": 0}, "sheet_most": {"type": "number", "minimum": 0},
    "paws_m": {"type": "number", "exclusiveMinimum": 0}, "paws_rough": {"type": "number", "minimum": 0}
   }
  },
  "sky": {"type": "object", "strict": true, "required": ["top", "horizon", "ground"],
          "properties": {"top": {"$ref": "#/$defs/hex"}, "horizon": {"$ref": "#/$defs/hex"}, "ground": {"$ref": "#/$defs/hex"}}},
  "terrain": {"type": "object", "properties": {"_doc": {"type": "string", "minLength": 1}}, "additional": {"$ref": "#/$defs/value"},
              "description": "the ground's look, set key by key on the terrain's and the verge's shaders (render/city_world.gd)",
              "required": ["grass_map", "rock", "sand", "land_map", "grass_m", "dirt_m", "rock_m", "dirt_layer", "rock_layer", "dirt_from", "dirt_to", "rock_slope"]}
 }
}
