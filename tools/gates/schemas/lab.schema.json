{
 "type": "object",
 "strict": true,
 "required": ["_doc", "views", "recorder", "resources", "cpu"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "views": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z_]*$", "description": "a Viewport.DebugDraw name"}},
  "recorder": {"type": "object", "strict": true, "required": ["settle_ms"], "properties": {"settle_ms": {"type": "number", "minimum": 0}}},
  "cpu": {"type": "object", "strict": true, "required": ["window_frames", "tail"],
          "properties": {"window_frames": {"type": "integer", "minimum": 1}, "tail": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}},
  "resources": {"type": "object", "strict": true, "required": ["window_s", "least_s", "grow_mib_min", "grow_count_min", "best_method"],
                "properties": {"window_s": {"type": "number", "exclusiveMinimum": 0}, "least_s": {"type": "number", "exclusiveMinimum": 0},
                               "grow_mib_min": {"type": "number", "minimum": 0}, "grow_count_min": {"type": "integer", "minimum": 0},
                               "best_method": {"type": "string", "enum": ["forward_plus", "mobile", "gl_compatibility"]}}}
 }
}
