{
 "$defs": {
  "share": {"type": "number", "minimum": 0, "maximum": 1},
  "length": {"type": "number", "exclusiveMinimum": 0},
  "metres": {"type": "number", "minimum": 0},
  "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
  "range": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/length"}, {"$ref": "#/$defs/length"}]},
  "lumps": {"type": "object", "strict": true,
            "required": ["seed", "variants", "spacing_m", "least", "size_m", "upright", "sink", "tint_vary", "road_margin_m", "casts", "sways", "rough", "subdiv", "jitter", "shade_bottom", "dark", "lit"],
            "properties": {"seed": {"type": "integer"}, "variants": {"type": "integer", "minimum": 1}, "spacing_m": {"$ref": "#/$defs/length"}, "least": {"$ref": "#/$defs/share"},
                           "size_m": {"$ref": "#/$defs/range"}, "upright": {"type": "number", "minimum": 0}, "sink": {"$ref": "#/$defs/share"}, "tint_vary": {"$ref": "#/$defs/share"},
                           "road_margin_m": {"$ref": "#/$defs/metres"}, "casts": {"type": "boolean"}, "sways": {"type": "boolean"},
                           "rough": {"$ref": "#/$defs/share"}, "subdiv": {"type": "integer", "minimum": 0}, "jitter": {"$ref": "#/$defs/share"},
                           "shade_bottom": {"$ref": "#/$defs/share"}, "dark": {"$ref": "#/$defs/hex"}, "lit": {"$ref": "#/$defs/hex"}}}
 },
 "type": "object",
 "strict": true,
 "required": ["_doc", "reach_m", "fade_m", "tuft_share", "elements", "shore", "rocks", "scrub", "cactus", "tufts", "flowers"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "reach_m": {"$ref": "#/$defs/length"},
  "fade_m": {"$ref": "#/$defs/metres"},
  "tuft_share": {"$ref": "#/$defs/share"},
  "elements": {"type": "object", "strict": true, "required": ["reach_m", "read_every_s", "max_emitters", "props", "effects"],
               "properties": {"reach_m": {"$ref": "#/$defs/length"}, "read_every_s": {"$ref": "#/$defs/length"}, "max_emitters": {"type": "integer", "minimum": 1},
                              "props": {"type": "array", "minItems": 1, "description": "by element kind: the models one is drawn from",
                                        "items": {"type": "array", "items": {"type": "string", "pattern": "^res://assets/elements/.+\\.(gltf|png)$"}}},
                              "effects": {"type": "array", "minItems": 1,
                                          "items": {"type": "object", "strict": true, "required": ["color", "rate", "size", "life", "spread", "rise", "cone_deg", "glows"],
                                                    "properties": {"color": {"$ref": "#/$defs/hex"}, "rate": {"type": "number", "exclusiveMinimum": 0}, "size": {"$ref": "#/$defs/length"},
                                                                   "life": {"$ref": "#/$defs/length"}, "spread": {"$ref": "#/$defs/metres"}, "rise": {"$ref": "#/$defs/metres"},
                                                                   "cone_deg": {"type": "number", "minimum": 0, "maximum": 180}, "glows": {"type": "boolean"}}}}}},
  "shore": {"type": "object", "strict": true, "required": ["bands", "reach_m", "search_m", "size_m", "size_power", "spacing_m"],
            "properties": {"_doc": {"type": "string"}, "spacing_m": {"$ref": "#/$defs/length"}, "search_m": {"$ref": "#/$defs/length"}, "size_m": {"$ref": "#/$defs/range"},
                           "size_power": {"type": "number", "exclusiveMinimum": 0}, "reach_m": {"$ref": "#/$defs/length"},
                           "bands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"type": "number"}, {"type": "number"}]}}}},
  "rocks": {"$ref": "#/$defs/lumps"},
  "scrub": {"$ref": "#/$defs/lumps"},
  "cactus": {"type": "object", "strict": true,
             "required": ["seed", "variants", "spacing_m", "least", "size_m", "upright", "sink", "tint_vary", "road_margin_m", "casts", "sways", "radius", "ribs", "arms", "arm_from", "arm_reach", "arm_rise", "lit"],
             "properties": {"seed": {"type": "integer"}, "variants": {"type": "integer", "minimum": 1}, "spacing_m": {"$ref": "#/$defs/length"}, "least": {"$ref": "#/$defs/share"},
                            "size_m": {"$ref": "#/$defs/range"}, "upright": {"type": "number", "minimum": 0}, "sink": {"$ref": "#/$defs/share"}, "tint_vary": {"$ref": "#/$defs/share"},
                            "road_margin_m": {"$ref": "#/$defs/metres"}, "casts": {"type": "boolean"}, "sways": {"type": "boolean"},
                            "radius": {"$ref": "#/$defs/length"}, "ribs": {"type": "integer", "minimum": 3}, "arms": {"type": "integer", "minimum": 0},
                            "arm_from": {"$ref": "#/$defs/share"}, "arm_reach": {"$ref": "#/$defs/share"}, "arm_rise": {"$ref": "#/$defs/share"}, "lit": {"$ref": "#/$defs/hex"}}},
  "tufts": {"type": "object", "strict": true,
            "required": ["seed", "variants", "spacing_m", "least", "size_m", "upright", "sink", "tint_vary", "road_margin_m", "casts", "sways", "blades", "blade_width", "blade_lean", "dark", "lit"],
            "properties": {"seed": {"type": "integer"}, "variants": {"type": "integer", "minimum": 1}, "spacing_m": {"$ref": "#/$defs/length"}, "least": {"$ref": "#/$defs/share"},
                           "size_m": {"$ref": "#/$defs/range"}, "upright": {"type": "number", "minimum": 0}, "sink": {"$ref": "#/$defs/share"}, "tint_vary": {"$ref": "#/$defs/share"},
                           "road_margin_m": {"$ref": "#/$defs/metres"}, "casts": {"type": "boolean"}, "sways": {"type": "boolean"},
                           "blades": {"type": "integer", "minimum": 1}, "blade_width": {"$ref": "#/$defs/length"}, "blade_lean": {"$ref": "#/$defs/share"},
                           "dark": {"$ref": "#/$defs/hex"}, "lit": {"$ref": "#/$defs/hex"}}},
  "flowers": {"type": "object", "strict": true,
              "required": ["seed", "variants", "spacing_m", "least", "size_m", "upright", "sink", "tint_vary", "road_margin_m", "casts", "sways", "stem_radius", "head_radius", "head_shade", "dark", "blooms"],
              "properties": {"seed": {"type": "integer"}, "variants": {"type": "integer", "minimum": 1}, "spacing_m": {"$ref": "#/$defs/length"}, "least": {"$ref": "#/$defs/share"},
                             "size_m": {"$ref": "#/$defs/range"}, "upright": {"type": "number", "minimum": 0}, "sink": {"$ref": "#/$defs/share"}, "tint_vary": {"$ref": "#/$defs/share"},
                             "road_margin_m": {"$ref": "#/$defs/metres"}, "casts": {"type": "boolean"}, "sways": {"type": "boolean"},
                             "stem_radius": {"$ref": "#/$defs/length"}, "head_radius": {"$ref": "#/$defs/length"}, "head_shade": {"$ref": "#/$defs/share"},
                             "dark": {"$ref": "#/$defs/hex"}, "blooms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}}}}
 }
}
