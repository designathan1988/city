{
 "type": "object",
 "strict": true,
 "required": ["_doc", "control_marks", "signal_step_s"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "control_marks": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "strict": true,
    "required": ["glyph", "token", "label_key"],
    "properties": {
     "glyph": {"type": "string", "minLength": 1},
     "token": {"type": "string", "pattern": "^control_[a-z]+$"},
     "label_key": {"type": "string", "pattern": "^control\\.[a-z]+$"}
    }
   }
  },
  "signal_step_s": {"type": "number", "exclusiveMinimum": 0}
 }
}
