{
 "type": "object",
 "description": "the interface's design tokens: a colour '#rrggbb' or '#rrggbbaa', or a size (pixels; the few times and metres among them are P244's to move)",
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "bold_types": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Za-z]*$"}},
  "font_mono": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
  "font_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
 },
 "additional": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"}]},
 "required": ["_doc", "bold_types", "font_mono", "font_names"]
}
