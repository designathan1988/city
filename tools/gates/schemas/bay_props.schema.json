{
 "$defs": {
  "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
  "hexes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}},
  "share": {"type": "number", "minimum": 0, "maximum": 1},
  "length": {"type": "number", "exclusiveMinimum": 0},
  "vec3": {"type": "array", "minItems": 3, "items": false, "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}]},
  "size3": {"type": "array", "minItems": 3, "items": false, "prefixItems": [{"$ref": "#/$defs/length"}, {"$ref": "#/$defs/length"}, {"$ref": "#/$defs/length"}]},
  "range": {"type": "array", "minItems": 2, "items": false, "description": "least and most", "prefixItems": [{"type": "number"}, {"type": "number"}]},
  "tone": {"type": "array", "minItems": 3, "items": false, "prefixItems": [{"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}]},
  "segments": {"type": "integer", "minimum": 3},
  "box": {"type": "object", "strict": true, "required": ["shape", "min", "max", "tone"],
          "properties": {"shape": {"const": "box"}, "min": {"$ref": "#/$defs/vec3"}, "max": {"$ref": "#/$defs/vec3"}, "tone": {"$ref": "#/$defs/tone"}, "front": {"type": "boolean"}}},
  "bar": {"type": "object", "strict": true, "required": ["shape", "from", "to", "width", "tone"],
          "properties": {"shape": {"const": "bar"}, "from": {"$ref": "#/$defs/vec3"}, "to": {"$ref": "#/$defs/vec3"}, "width": {"$ref": "#/$defs/length"},
                         "thick": {"$ref": "#/$defs/length"}, "tone": {"$ref": "#/$defs/tone"}}},
  "frustum": {"type": "object", "strict": true, "required": ["shape", "base", "r0", "r1", "height", "segments", "tone"],
              "properties": {"shape": {"const": "frustum"}, "base": {"$ref": "#/$defs/vec3"}, "r0": {"$ref": "#/$defs/length"}, "r1": {"$ref": "#/$defs/length"},
                             "height": {"$ref": "#/$defs/length"}, "segments": {"$ref": "#/$defs/segments"}, "tone": {"$ref": "#/$defs/tone"}}},
  "disc": {"type": "object", "strict": true, "required": ["shape", "centre", "radius", "segments", "tone"],
           "properties": {"shape": {"const": "disc"}, "centre": {"$ref": "#/$defs/vec3"}, "radius": {"$ref": "#/$defs/length"}, "segments": {"$ref": "#/$defs/segments"},
                          "tone": {"$ref": "#/$defs/tone"}}},
  "ring": {"type": "object", "strict": true, "required": ["shape", "centre", "r0", "r1", "segments", "tone"],
           "properties": {"shape": {"const": "ring"}, "centre": {"$ref": "#/$defs/vec3"}, "r0": {"type": "number", "minimum": 0}, "r1": {"$ref": "#/$defs/length"},
                          "segments": {"$ref": "#/$defs/segments"}, "tone": {"$ref": "#/$defs/tone"}}},
  "blob": {"type": "object", "strict": true, "required": ["shape", "center", "radius", "tone"],
           "properties": {"shape": {"const": "blob"}, "center": {"$ref": "#/$defs/vec3"}, "radius": {"$ref": "#/$defs/size3"}, "tone": {"$ref": "#/$defs/tone"}}},
  "rosette": {"type": "object", "strict": true, "required": ["shape", "leaves", "seed", "joints", "length", "rise", "width", "shades", "twist", "tone"],
              "properties": {"shape": {"const": "rosette"}, "leaves": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"}, "joints": {"type": "integer", "minimum": 1},
                             "length": {"$ref": "#/$defs/range"}, "rise": {"$ref": "#/$defs/range"}, "width": {"$ref": "#/$defs/range"}, "shades": {"$ref": "#/$defs/range"},
                             "twist": {"$ref": "#/$defs/range"}, "tone": {"$ref": "#/$defs/tone"}}},
  "mound": {"type": "object", "strict": true, "required": ["shape", "leaves", "seed", "size", "shades", "lean", "reach", "centre", "tone"],
            "properties": {"shape": {"const": "mound"}, "leaves": {"type": "integer", "minimum": 1}, "seed": {"type": "integer"}, "size": {"$ref": "#/$defs/range"},
                           "shades": {"$ref": "#/$defs/range"}, "lean": {"$ref": "#/$defs/range"}, "reach": {"$ref": "#/$defs/range"},
                           "centre": {"type": "number", "description": "the mound's centre height"}, "tone": {"$ref": "#/$defs/tone"}}},
  "bowl": {"type": "object", "strict": true, "required": ["shape", "radius", "cap", "tilt", "centre", "segments", "rings", "tone"],
           "properties": {"shape": {"const": "bowl"}, "radius": {"$ref": "#/$defs/length"}, "cap": {"type": "number"}, "tilt": {"type": "number"},
                          "centre": {"$ref": "#/$defs/vec3"}, "segments": {"$ref": "#/$defs/segments"}, "rings": {"type": "integer", "minimum": 1}, "tone": {"$ref": "#/$defs/tone"}}},
  "parts": {"type": "array", "minItems": 1,
            "items": {"oneOf": [{"$ref": "#/$defs/box"}, {"$ref": "#/$defs/bar"}, {"$ref": "#/$defs/frustum"}, {"$ref": "#/$defs/disc"}, {"$ref": "#/$defs/ring"},
                                {"$ref": "#/$defs/blob"}, {"$ref": "#/$defs/rosette"}, {"$ref": "#/$defs/mound"}, {"$ref": "#/$defs/bowl"}]}}
 },
 "type": "object",
 "strict": true,
 "required": ["models", "colours", "shares"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "models": {"type": "object", "additional": {"$ref": "#/$defs/parts"},
             "required": ["ac", "pot", "foliage", "bush", "chair", "table", "airer", "dish", "lounger", "bike"]},
  "colours": {"type": "object", "strict": true, "required": ["ac_cases", "ac_old", "dish", "airer", "pots", "greens", "plastic", "fine", "loungers", "bikes"],
              "properties": {"ac_cases": {"$ref": "#/$defs/hexes"}, "ac_old": {"$ref": "#/$defs/hex"}, "dish": {"$ref": "#/$defs/hex"}, "airer": {"$ref": "#/$defs/hex"},
                             "pots": {"$ref": "#/$defs/hexes"}, "greens": {"$ref": "#/$defs/hexes"}, "plastic": {"$ref": "#/$defs/hexes"}, "fine": {"$ref": "#/$defs/hexes"},
                             "loungers": {"$ref": "#/$defs/hexes"}, "bikes": {"$ref": "#/$defs/hexes"}}},
  "shares": {"type": "object", "additional": {"$ref": "#/$defs/share"},
             "required": ["split_home", "split_shop", "split_works", "dish", "ac_old", "old_popular", "office_plant", "bare", "one_thing", "two_things", "its_kind",
                          "one_chair", "one_plant", "one_airer", "set_table", "lounger_high", "kind_airer", "kind_bike", "four_pots", "loggia_plant", "loggia_chair",
                          "loggia_lounger"]}
 }
}
