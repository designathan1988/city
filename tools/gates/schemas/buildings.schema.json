{
 "$defs": {
  "finish": {"type": "string", "enum": ["plaster", "stucco", "ceramic", "brick", "stone", "concrete", "wood", "metal", "glass", "tile", "slate", "panel", "roofing", "grass", "plastic"]},
  "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
  "paint": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/finish"}, {"$ref": "#/$defs/hex"}]},
  "paints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/paint"}},
  "hexes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}},
  "share": {"type": "number", "minimum": 0, "maximum": 1},
  "metres": {"type": "number", "minimum": 0},
  "length": {"type": "number", "exclusiveMinimum": 0},
  "seconds": {"type": "number", "minimum": 0},
  "bay": {"type": "string", "enum": ["wall", "window", "sash", "french", "bayWindow", "ribbon", "wide", "balcony", "door", "doubleDoor", "garageDoor", "shopfront", "loadingDoor", "pillar", "loggia", "brise", "shuttered", "gourmet"]},
  "architecture_name": {"type": "string", "enum": ["colonial", "artDeco", "modernist", "contemporary", "brick", "tropical", "glass", "industrial", "colonialHouse", "bungalow", "modernHouse", "sobrado"]},
  "weights": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/architecture_name"}, {"type": "number", "exclusiveMinimum": 0}]}},
  "boundary": {"type": "array", "minItems": 1,
               "items": {"type": "array", "minItems": 3, "items": false, "description": "the boundary's kind, its height and its share of lots without it",
                         "prefixItems": [{"type": "string", "enum": ["fence", "hedge", "railing", "wall"]}, {"$ref": "#/$defs/length"}, {"$ref": "#/$defs/share"}]}},
  "opening": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number", "minimum": 0}},
  "architecture": {
   "type": "object", "strict": true,
   "required": ["name", "skins", "trims", "rhythms", "side_fill", "ground_fill", "top", "lines", "crown", "opening", "piers", "stone_base", "module"],
   "properties": {
    "name": {"$ref": "#/$defs/architecture_name"},
    "skins": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/finish"}, {"$ref": "#/$defs/hexes"}]}},
    "trims": {"$ref": "#/$defs/paints"},
    "rhythms": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bay"}}},
    "side_fill": {"$ref": "#/$defs/bay"},
    "ground_fill": {"$ref": "#/$defs/bay"},
    "top": {"type": "string", "enum": ["", "ribbon", "wide", "window"], "description": "the top storey's fill, '' for the rhythm's own"},
    "lines": {"type": "string", "enum": ["every", "base", "slab", "none"]},
    "crown": {"type": "string", "enum": ["cornice", "deco", "slab", "attic", "none"]},
    "opening": {"type": "array", "minItems": 5, "items": false, "description": "window width's least and most share of a bay, height's least and most share of a storey, sill height in metres",
                "prefixItems": [{"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}, {"$ref": "#/$defs/metres"}]},
    "piers": {"oneOf": [{"type": "array", "maxItems": 0, "items": false},
                        {"type": "array", "minItems": 3, "items": false, "description": "a pier's width and depth in metres, every how many bays",
                         "prefixItems": [{"$ref": "#/$defs/length"}, {"$ref": "#/$defs/length"}, {"type": "integer", "minimum": 1}]}]},
    "stone_base": {"type": "boolean"},
    "module": {"$ref": "#/$defs/length"}
   }
  },
  "style": {
   "type": "object", "strict": true,
   "required": ["architectures", "kind_weights", "era_affinity", "palettes", "colors", "openings", "parts", "lot", "roof", "props", "lots"],
   "properties": {
    "architectures": {"type": "array", "minItems": 1, "unique_key": "name", "items": {"$ref": "#/$defs/architecture"}},
    "kind_weights": {"type": "object", "strict": true, "required": ["house", "flats", "tower", "shop", "office", "works"],
                     "properties": {"house": {"$ref": "#/$defs/weights"}, "flats": {"$ref": "#/$defs/weights"}, "tower": {"$ref": "#/$defs/weights"},
                                    "shop": {"$ref": "#/$defs/weights"}, "office": {"$ref": "#/$defs/weights"}, "works": {"$ref": "#/$defs/weights"}}},
    "era_affinity": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}},
    "palettes": {"type": "object", "strict": true,
                 "required": ["bricks", "hard", "roof_tiles", "flat_roofs", "works_roofs", "awnings", "shop_awnings", "lot_walls", "tanks", "warehouse_walls"],
                 "properties": {"bricks": {"$ref": "#/$defs/paints"}, "hard": {"$ref": "#/$defs/paints"}, "roof_tiles": {"$ref": "#/$defs/paints"},
                                "flat_roofs": {"$ref": "#/$defs/paints"}, "works_roofs": {"$ref": "#/$defs/paints"}, "awnings": {"$ref": "#/$defs/hexes"},
                                "shop_awnings": {"$ref": "#/$defs/hexes"}, "lot_walls": {"$ref": "#/$defs/paints"}, "tanks": {"$ref": "#/$defs/hexes"},
                                "warehouse_walls": {"$ref": "#/$defs/hexes"}}},
    "colors": {"type": "object", "additional": {"$ref": "#/$defs/paint"}, "description": "paints by the name the code asks (named() in the loaders and emitters)",
               "required": ["office_roof", "membrane", "terrace", "plinth", "veranda_floor", "machine_glass", "machine_top", "coping_metal", "pane", "sill", "door",
                            "shutter", "roof_railing", "glass_rail", "lamp", "louvre_default", "frame_default", "plant_metal", "plant_dark", "plant_door", "solar",
                            "skylight", "chimney", "column", "arcade_floor", "deck", "pot", "soil", "parasol", "kerb", "paving", "asphalt", "concrete", "pavers",
                            "tiles", "house_path", "path", "stone_path", "pool", "pool_side", "pool_coping", "stall_line", "stall", "wall_coping", "fence", "gate",
                            "lamp_post", "bench", "planter", "planter_soil", "bin", "skip", "wall_ac", "grille", "canopy", "shed", "shed_roof", "edicula_roof",
                            "edicula", "lawn", "hedge", "warehouse_roof", "sawtooth_glass", "dock", "dock_door", "civic_wall", "empty_kerb", "square_paving",
                            "square_lawn", "school_roof", "court", "court_run", "court_line", "church_wall", "church_roof", "gold", "hospital_wall", "hospital_band",
                            "red_cross", "sign_white", "fuel_canopy", "fuel_brand", "fuel_pump", "market_sign", "mall_sign", "hall_roof", "flag", "civic_stone",
                            "fire_wall", "fire_tower", "fire_band", "police_wall", "police_band", "fountain_water", "sand", "play_red", "play_yellow", "play_blue",
                            "flowers", "flowers_alt", "parking_asphalt", "gear_metal", "gear_panel", "gear_glazing", "gear_masonry", "gear_cap", "gear_base",
                            "lantern_stone", "lantern_render", "lantern_glass", "lantern_frame", "lantern_dome", "lantern_mast", "lantern_beacon"]},
    "openings": {"type": "object", "additional": {"$ref": "#/$defs/opening"},
                 "required": ["_doc", "window", "sash", "wide", "balcony", "door", "doubleDoor", "french", "bayWindow", "ribbon", "shopfront", "loadingDoor",
                              "garageDoor", "loggia", "brise", "shuttered", "gourmet"],
                 "properties": {"_doc": {"type": "string", "minLength": 1}}},
    "parts": {"type": "object", "strict": true, "required": ["_doc", "frame_bar_m", "handle_h_m", "brise_fin_m", "guard_h_m"],
              "properties": {"_doc": {"type": "string"}, "frame_bar_m": {"$ref": "#/$defs/length"}, "handle_h_m": {"$ref": "#/$defs/length"},
                             "brise_fin_m": {"$ref": "#/$defs/length"}, "guard_h_m": {"$ref": "#/$defs/length"}}},
    "lot": {"type": "object", "strict": true, "required": ["_doc", "fence_bar_m"], "properties": {"_doc": {"type": "string"}, "fence_bar_m": {"$ref": "#/$defs/length"}}},
    "roof": {"type": "object", "strict": true, "required": ["_doc", "air_handler_per_area"],
             "properties": {"_doc": {"type": "string"}, "air_handler_per_area": {"type": "integer", "minimum": 1}}},
    "props": {"type": "object", "strict": true, "required": ["lit_share"],
              "properties": {"lit_share": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}]}}},
    "lots": {
     "type": "object", "strict": true,
     "required": ["_doc", "stall_w", "stall_d", "aisle", "stall_line", "drive_lane", "car_clear_h", "person_gate", "party_wall", "front_low", "block_closes_m", "pool", "pool_share",
                  "terrace", "garage_back_share", "yard_life_depth", "max_elements", "garage_closed_share", "lorry_w", "dock_margin", "boundary", "lorry_l"],
     "properties": {
      "_doc": {"type": "string"},
      "stall_w": {"$ref": "#/$defs/length"}, "stall_d": {"$ref": "#/$defs/length"}, "aisle": {"$ref": "#/$defs/length"}, "stall_line": {"$ref": "#/$defs/length"},
      "drive_lane": {"$ref": "#/$defs/length"}, "car_clear_h": {"$ref": "#/$defs/length"},
      "person_gate": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/length"}},
      "party_wall": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/length"}},
      "front_low": {"$ref": "#/$defs/length"}, "block_closes_m": {"$ref": "#/$defs/length"},
      "pool": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/length"}},
      "pool_share": {"$ref": "#/$defs/share"}, "terrace": {"$ref": "#/$defs/length"}, "garage_back_share": {"$ref": "#/$defs/share"},
      "yard_life_depth": {"$ref": "#/$defs/length"}, "max_elements": {"type": "integer", "minimum": 1}, "garage_closed_share": {"$ref": "#/$defs/share"},
      "lorry_w": {"$ref": "#/$defs/length"}, "lorry_l": {"$ref": "#/$defs/length"}, "dock_margin": {"$ref": "#/$defs/metres"},
      "boundary": {"type": "object", "strict": true, "required": ["house", "flats", "tower", "shop", "office", "works"],
                   "properties": {"house": {"$ref": "#/$defs/boundary"}, "flats": {"$ref": "#/$defs/boundary"}, "tower": {"$ref": "#/$defs/boundary"},
                                  "shop": {"$ref": "#/$defs/boundary"}, "office": {"$ref": "#/$defs/boundary"}, "works": {"$ref": "#/$defs/boundary"}}}
     }
    }
   }
  }
 },
 "type": "object",
 "strict": true,
 "required": ["_doc", "finish_far", "lod", "styles"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "finish_far": {"type": "object", "strict": true, "required": ["tones"],
                 "properties": {"_doc": {"type": "string"},
                                "tones": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 3, "items": false,
                                                                                    "prefixItems": [{"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}, {"$ref": "#/$defs/share"}]}}}},
  "lod": {"type": "object", "strict": true,
          "required": ["_doc", "parts_share", "near_share", "fov_deg", "far_hysteresis", "far_rebuild_delay_s", "far_rebuild_interval_s", "part_bands"],
          "properties": {"_doc": {"type": "string"}, "parts_share": {"$ref": "#/$defs/share"}, "near_share": {"$ref": "#/$defs/share"},
                         "fov_deg": {"type": "integer", "minimum": 1, "maximum": 179}, "hull_error_m": {"$ref": "#/$defs/metres"},
                         "far_hysteresis": {"type": "number", "minimum": 0}, "far_rebuild_delay_s": {"$ref": "#/$defs/seconds"},
                         "far_rebuild_interval_s": {"$ref": "#/$defs/seconds"}, "cast_props_m": {"$ref": "#/$defs/metres"}, "far_per_eye": {"type": "number", "minimum": 0},
                         "part_bands": {"type": "array", "minItems": 1,
                                        "items": {"type": "object", "strict": true, "required": ["thick_max", "px_min"],
                                                  "properties": {"thick_max": {"$ref": "#/$defs/metres"}, "px_min": {"type": "number", "minimum": 0}}}}}},
  "styles": {"type": "object", "additional": {"$ref": "#/$defs/style"}}
 }
}
