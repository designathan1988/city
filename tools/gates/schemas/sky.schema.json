{
 "type": "object",
 "description": "the drawn sky's numbers (render/sky_view.gd, weather_view.gd, thunder.gd): every key a number but the noise picture and the puffs",
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "start_noise": {"type": "string", "pattern": "^res://.+\\.png$"},
  "puffs": {"type": "array", "minItems": 1,
            "items": {"type": "array", "minItems": 4, "items": false, "description": "across, up, along, radius in units of the cloud's size",
                      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number", "exclusiveMinimum": 0}]}}
 },
 "additional": {"type": "number"},
 "required": ["_doc", "start_noise", "puffs", "rain_mist", "rain_mist_height_m"]
}
