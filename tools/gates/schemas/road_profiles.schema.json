{
 "$defs": {
  "price": {"type": "number", "minimum": 0, "description": "money per m2 of that part of the cross-section"},
  "factor": {"type": "number", "exclusiveMinimum": 0},
  "style": {"type": "object", "strict": true, "required": ["prices", "structure"],
            "properties": {"prices": {"type": "object", "strict": true, "required": ["carriageway", "median", "footway"],
                                      "properties": {"carriageway": {"$ref": "#/$defs/price"}, "median": {"$ref": "#/$defs/price"}, "footway": {"$ref": "#/$defs/price"}}},
                           "structure": {"type": "object", "strict": true, "required": ["ground", "embankment", "trench", "bridge", "tunnel"],
                                         "properties": {"ground": {"$ref": "#/$defs/factor"}, "embankment": {"$ref": "#/$defs/factor"}, "trench": {"$ref": "#/$defs/factor"},
                                                        "bridge": {"$ref": "#/$defs/factor"}, "tunnel": {"$ref": "#/$defs/factor"}}}}},
  "strip": {"type": "object", "strict": true, "required": ["kind", "width"],
            "properties": {"kind": {"type": "string", "pattern": "^[a-z]+$"}, "width": {"type": "number", "exclusiveMinimum": 0},
                           "dir": {"type": "integer", "enum": [-1, 0, 1]}, "pave": {"type": "integer", "minimum": 0},
                           "flush": {"type": "boolean"}, "bus": {"type": "boolean"}, "rail": {"type": "boolean"}}},
  "profile": {"type": "object", "strict": true,
              "required": ["id", "name_key", "road_class", "rank", "class_card", "speed", "one_way", "priority", "category", "ring", "surface", "centre", "strips"],
              "properties": {"id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}, "name_key": {"type": "string", "pattern": "^[a-zA-Z0-9_.]+$"},
                             "road_class": {"type": "string", "pattern": "^[a-z]+$"}, "rank": {"type": "integer", "minimum": 0}, "class_card": {"type": "boolean"},
                             "speed": {"type": "integer", "minimum": 1}, "one_way": {"type": "boolean"}, "priority": {"type": "integer", "minimum": 0},
                             "category": {"type": "string", "pattern": "^[a-z]+$"}, "ring": {"type": "boolean"},
                             "surface": {"type": "integer", "minimum": 0, "maximum": 3, "description": "by position (P263)"},
                             "centre": {"type": "string", "pattern": "^[a-z_]*$"},
                             "strips": {"type": "array", "items": {"$ref": "#/$defs/strip"}}}}
 },
 "type": "object",
 "strict": true,
 "required": ["styles", "profiles"],
 "properties": {
  "styles": {"type": "object", "properties": {"_doc": {"type": "string"}}, "additional": {"$ref": "#/$defs/style"}},
  "profiles": {"type": "array", "unique_key": "id", "items": {"$ref": "#/$defs/profile"}}
 }
}
