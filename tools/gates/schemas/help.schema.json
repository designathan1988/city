{
 "$defs": {
  "key": {"type": "string", "pattern": "^[a-zA-Z0-9_.]+$", "description": "a translation key"},
  "row": {"type": "array", "minItems": 2, "items": false, "description": "the key's text and what it does", "prefixItems": [{"$ref": "#/$defs/key"}, {"$ref": "#/$defs/key"}]},
  "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}}
 },
 "type": "object",
 "strict": true,
 "required": ["_doc", "tool_keys", "groups", "tool_names"],
 "properties": {
  "_doc": {"type": "string", "minLength": 1},
  "tool_keys": {"type": "object", "additional": {"$ref": "#/$defs/rows"}, "description": "by ToolController.Tool name"},
  "groups": {"type": "array", "minItems": 1,
             "items": {"type": "object", "strict": true, "required": ["title_key", "rows"], "properties": {"title_key": {"$ref": "#/$defs/key"}, "rows": {"$ref": "#/$defs/rows"}}}},
  "tool_names": {"type": "object", "additional": {"$ref": "#/$defs/key"}}
 }
}
