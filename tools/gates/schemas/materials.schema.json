{
 "$defs": {
  "shader": {"type": "string", "pattern": "^res://render/shaders/[a-z_]+\\.gdshader$"},
  "colour": {"type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"},
  "value": {"description": "a uniform's value as render/city_world.gd shader_value reads it; gate_materials.py checks the name and the type against the shader",
            "oneOf": [{"type": "number"}, {"type": "boolean"},
                      {"type": "string", "pattern": "^(res://.+|#([0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"},
                      {"type": "array", "minItems": 1, "items": {"type": "number"}},
                      {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/colour"}}]},
  "material": {
   "type": "object", "strict": true, "required": ["shader", "params"],
   "properties": {
    "_doc": {"type": "string", "minLength": 1},
    "shader": {"$ref": "#/$defs/shader"},
    "params": {"type": "object", "additional": {"$ref": "#/$defs/value"}},
    "fade_shader": {"$ref": "#/$defs/shader"},
    "ruin_shader": {"$ref": "#/$defs/shader"},
    "body_shader": {"$ref": "#/$defs/shader"},
    "blend_shader": {"$ref": "#/$defs/shader"},
    "layers": {"type": "integer", "minimum": 1},
    "render_priority": {"type": "integer"},
    "display_colors": {"type": "object", "additional": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/colour"}}}
   }
  }
 },
 "type": "object",
 "additional": {"$ref": "#/$defs/material"},
 "properties": {"_doc": {"type": "string", "minLength": 1}},
 "required": ["_doc", "verge", "road", "building", "building_glass", "building_wash", "building_sheer", "building_card", "building_props", "building_ghost",
              "building_far", "building_parts", "prop", "agent", "transit", "transit_glass", "transit_xray", "shadow_caster", "agent_glass", "people_blob",
              "people", "people_held", "people_helmet", "people_far", "overlay", "vegetation", "cover_plant", "cover_rock", "cover_shore", "vegetation_cards",
              "puffs", "debris", "rubble", "marks", "lamp_glow"]
}
