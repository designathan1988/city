{
  "$defs": {
    "text": {"type": "string"},
    "pair": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string"}]},
    "icon_label": {
      "type": "object", "strict": true,
      "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"}},
      "required": ["icon", "label_key"]
    },
    "kind_row": {
      "type": "object", "strict": true,
      "description": "a choice whose kind is a position of a core enumeration (sim/street/street_works.h ItemKind, BarrierKind, the lamp pattern, the pole kind, the lot cut)",
      "properties": {"icon": {"type": "string"}, "kind": {"type": "integer", "minimum": 0}, "label_key": {"type": "string"}},
      "required": ["icon", "kind", "label_key"]
    },
    "tab": {
      "type": "object", "strict": true,
      "properties": {
        "id": {"type": "string"},
        "icon": {"type": "string"},
        "label_key": {"type": "string"},
        "tool": {"type": "string", "enum": ["ROAD", "ZONE", "DEMOLISH", "INSPECT", "UPGRADE", "SPLIT", "ROUNDABOUT", "TERRAIN", "BUILD", "LOT",
          "LOTS", "MOVE", "CONTROL", "PAINT", "TREES", "CLOUD", "STRIKE", "SHOOT", "TRANSIT", "POLE", "BARRIER", "STREETSCAPE"]},
        "kind": {"type": "string"},
        "mode": {"type": "integer"},
        "profile": {"type": "string"},
        "note_key": {"type": "string"}
      },
      "required": ["id", "icon", "label_key"]
    },
    "card": {
      "type": "object", "strict": true,
      "properties": {
        "label_key": {"type": "string"},
        "zone": {"type": "integer", "minimum": 0, "maximum": 8},
        "swatch": {"type": "string"},
        "icon": {"type": "string"},
        "mode": {"type": "integer", "minimum": 0, "maximum": 8},
        "fn": {"type": "integer", "minimum": 0, "maximum": 34}
      },
      "required": ["label_key"]
    },
    "category": {
      "type": "object", "strict": true,
      "properties": {
        "id": {"type": "string"},
        "icon": {"type": "string"},
        "label_key": {"type": "string"},
        "tip_key": {"type": "string"},
        "strip": {"type": "string", "enum": ["road_catalog", "zone_cards", "land_panels", "build_cards"]},
        "danger": {"type": "boolean"},
        "no_drawer": {"type": "boolean"},
        "tabs": {"type": "array", "items": {"$ref": "#/$defs/tab"}, "unique_key": "id"},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
        "ring": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"}, "min": {"type": "number"}, "max": {"type": "number"}, "step": {"type": "number"},
            "default": {"type": "number"}},
          "required": ["label_key", "step", "default"]
        }
      },
      "required": ["id", "icon", "label_key", "tip_key", "tabs"]
    },
    "road_options": {
      "type": "object", "strict": true,
      "properties": {
        "_doc": {"type": "string"},
        "cell_m": {"type": "number", "exclusiveMinimum": 0},
        "trace": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"},
            "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/icon_label"}}},
          "required": ["label_key", "choices"]
        },
        "snap": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"},
            "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {
              "type": "object", "strict": true,
              "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"}, "key": {"type": "string", "enum": ["on", "angles", "grid"]}},
              "required": ["icon", "label_key", "key"]}}},
          "required": ["label_key", "choices"]
        },
        "furniture": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"}, "tip_key": {"type": "string"},
            "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {
              "type": "object", "strict": true,
              "properties": {"label_key": {"type": "string"}, "level": {"type": "integer"}},
              "required": ["label_key", "level"]}}},
          "required": ["label_key", "tip_key", "choices"]
        },
        "blocks": {
          "type": "object", "strict": true,
          "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"}, "count_key": {"type": "string"}, "measure_key": {"type": "string"}},
          "required": ["icon", "label_key", "count_key", "measure_key"]
        },
        "lanes": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"}, "median_road": {"type": "string", "minLength": 1},
            "choices": {"type": "array", "minItems": 1, "items": {
              "type": "object", "strict": true,
              "properties": {"icon": {"type": "string"}, "count": {"type": "integer", "minimum": 0}},
              "required": ["icon", "count"]}}},
          "required": ["label_key", "median_road", "choices"]
        },
        "width": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"}, "step_m": {"type": "number", "exclusiveMinimum": 0}},
          "required": ["label_key", "step_m"]
        },
        "parking": {
          "type": "object", "strict": true,
          "properties": {"label_key": {"type": "string"},
            "choices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/icon_label"}}},
          "required": ["label_key", "choices"]
        }
      },
      "required": ["cell_m", "trace", "snap", "furniture", "blocks", "lanes", "width", "parking"]
    },
    "action_row": {
      "type": "object", "strict": true,
      "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"}, "action": {"type": "string", "minLength": 1}},
      "required": ["icon", "label_key", "action"]
    },
    "popovers": {
      "type": "object", "strict": true,
      "properties": {
        "layers": {
          "type": "object", "strict": true,
          "properties": {"title_key": {"type": "string"},
            "rows": {"type": "array", "minItems": 1, "unique_key": "action", "items": {
              "type": "object", "strict": true,
              "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"},
                "action": {"type": "string", "enum": ["zones", "congestion", "grid", "interior"]}},
              "required": ["icon", "label_key", "action"]}}},
          "required": ["title_key", "rows"]
        },
        "menu": {
          "type": "object", "strict": true,
          "properties": {
            "rows": {"type": "array", "minItems": 1, "items": {"oneOf": [
              {"type": "object", "strict": true, "properties": {"rule": {"const": true}}, "required": ["rule"]},
              {"type": "object", "strict": true, "required": ["seg", "label_key"],
                "properties": {"seg": {"type": "string", "enum": ["quality", "language", "paint"]}, "label_key": {"type": "string"}}},
              {"$ref": "#/$defs/action_row"}]}},
            "large_maps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "required": ["rows", "large_maps"]
        },
        "camera": {
          "type": "object", "strict": true,
          "properties": {"title_key": {"type": "string"},
            "buttons": {"type": "array", "minItems": 1, "items": {
              "type": "object", "strict": true,
              "properties": {"icon": {"type": "string"}, "label_key": {"type": "string"},
                "action": {"type": "string", "enum": ["north", "perspective", "tilt_down", "tilt_up", "turn_left", "turn_right", "reset"]}},
              "required": ["icon", "label_key", "action"]}}},
          "required": ["title_key", "buttons"]
        },
        "sim": {
          "type": "object", "strict": true,
          "properties": {
            "title_key": {"type": "string"},
            "level_max_pct": {"type": "integer", "minimum": 1},
            "level_step_pct": {"type": "integer", "minimum": 1},
            "demand": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "items": false,
              "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "string"}]}},
            "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}}
          },
          "required": ["title_key", "level_max_pct", "level_step_pct", "demand", "metrics"]
        },
        "help": {"type": "object", "strict": true, "properties": {"title_key": {"type": "string"}}, "required": ["title_key"]},
        "files": {"type": "object", "strict": true, "properties": {"title_key": {"type": "string"}, "empty_key": {"type": "string"}},
          "required": ["title_key", "empty_key"]}
      },
      "required": ["layers", "menu", "camera", "sim", "help", "files"]
    },
    "street": {
      "type": "object", "strict": true,
      "properties": {
        "_doc": {"type": "string"},
        "item_columns": {"type": "integer", "minimum": 1},
        "barrier_columns": {"type": "integer", "minimum": 1},
        "reach_m": {"type": "number", "exclusiveMinimum": 0},
        "pick_px": {"type": "number", "exclusiveMinimum": 0},
        "pole_reach_m": {"type": "number", "exclusiveMinimum": 0},
        "placing_ring_m": {"type": "number", "exclusiveMinimum": 0},
        "double_click_ms": {"type": "integer", "minimum": 1},
        "double_click_m": {"type": "number", "exclusiveMinimum": 0},
        "text_max": {"type": "integer", "minimum": 1},
        "sign_kind": {"type": "integer", "minimum": 0},
        "name_kind": {"type": "integer", "minimum": 0},
        "name_hint": {"type": "string"},
        "default_lamps": {"type": "integer", "minimum": 0},
        "default_pole_kind": {"type": "integer", "minimum": 0},
        "items": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {
          "type": "object", "strict": true,
          "properties": {"icon": {"type": "string"}, "kind": {"type": "integer", "minimum": 0}, "label_key": {"type": "string"},
            "row_m": {"type": "number", "exclusiveMinimum": 0, "description": "the spacing of a dragged row; a piece without it is placed one at a time"}},
          "required": ["icon", "kind", "label_key"]}},
        "barriers": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {
          "type": "object", "strict": true,
          "properties": {"icon": {"type": "string"}, "kind": {"type": "integer", "minimum": 0}, "label_key": {"type": "string"},
            "half_width_m": {"type": "number", "exclusiveMinimum": 0}},
          "required": ["icon", "kind", "label_key", "half_width_m"]}},
        "poles": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {
          "type": "object", "strict": true,
          "properties": {"icon": {"type": "string"}, "kind": {"type": "string", "enum": ["build", "remove"]}, "label_key": {"type": "string"}},
          "required": ["icon", "kind", "label_key"]}},
        "lamps": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {"$ref": "#/$defs/kind_row"}},
        "pole_kinds": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {"$ref": "#/$defs/kind_row"}},
        "signs": {"type": "array", "minItems": 1, "unique_key": "sign", "items": {
          "type": "object", "strict": true,
          "properties": {"sign": {"type": "integer", "minimum": 0}, "label_key": {"type": "string"}, "text_hint": {"type": "string"}},
          "required": ["sign", "label_key"]}}
      },
      "required": ["item_columns", "barrier_columns", "reach_m", "pick_px", "pole_reach_m", "placing_ring_m", "double_click_ms", "double_click_m",
        "text_max", "sign_kind", "name_kind", "name_hint", "default_lamps", "default_pole_kind", "items", "barriers", "poles", "lamps",
        "pole_kinds", "signs"]
    },
    "lot_cards": {
      "type": "object", "strict": true,
      "properties": {
        "parts_least": {"type": "integer", "minimum": 2},
        "parts_most": {"type": "integer", "minimum": 2},
        "line_cut": {"type": "integer", "minimum": 0},
        "cards": {"type": "array", "minItems": 1, "unique_key": "mode", "items": {
          "type": "object", "strict": true,
          "properties": {"mode": {"type": "string", "enum": ["add", "polygon", "edit", "curve", "front", "split", "join", "delete"]},
            "label_key": {"type": "string"}, "icon": {"type": "string"}},
          "required": ["mode", "label_key", "icon"]}},
        "cuts": {"type": "array", "minItems": 1, "unique_key": "kind", "items": {"$ref": "#/$defs/kind_row"}}
      },
      "required": ["parts_least", "parts_most", "line_cut", "cards", "cuts"]
    }
  },
  "type": "object",
  "strict": true,
  "properties": {
    "_doc": {"type": "string"},
    "first_road": {"type": "string"},
    "categories": {"type": "array", "minItems": 7, "maxItems": 7, "unique_key": "id", "items": {"$ref": "#/$defs/category"}},
    "road_options": {"$ref": "#/$defs/road_options"},
    "catalog_tabs": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
    "profile_palette": {"type": "array", "items": {"$ref": "#/$defs/pair"}},
    "profile_defaults": {"type": "object", "additional": {"type": "number", "exclusiveMinimum": 0}},
    "fn_keys": {"type": "array", "items": {"type": "string"}},
    "zone_radius": {"type": "number", "minimum": 10, "maximum": 200},
    "actions": {"type": "array", "items": {
      "type": "object", "strict": true,
      "properties": {"icon": {"type": "string"}, "tip_key": {"type": "string"},
        "popover": {"type": "string", "enum": ["layers", "sim", "camera", "help", "menu", "files"]},
        "action": {"type": "string", "enum": ["undo", "redo"]}},
      "required": ["icon", "tip_key"]}},
    "popovers": {"$ref": "#/$defs/popovers"},
    "street": {"$ref": "#/$defs/street"},
    "lot_cards": {"$ref": "#/$defs/lot_cards"}
  },
  "required": ["categories", "first_road", "catalog_tabs", "profile_palette", "profile_defaults", "fn_keys", "zone_radius", "road_options", "actions",
    "popovers", "street", "lot_cards"]
}
