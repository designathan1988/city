{
  "description": "The gates' own configuration (tools/gates/rules.json), judged by the data gate like any table: a misspelt key, a list written twice or a key no gate reads any more is a finding here, not a rule silently off.",
  "$defs": {
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "some_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "doc": {"type": "string", "minLength": 1},
    "per_extension": {"type": "object", "additional": {"type": "integer", "minimum": 1}}
  },
  "type": "object",
  "strict": true,
  "properties": {
    "exclude_dirs": {"$ref": "#/$defs/some_paths"},
    "root_allowed": {"$ref": "#/$defs/some_paths"},
    "allowed_docs": {"$ref": "#/$defs/some_paths"},
    "doc_exempt_names": {"$ref": "#/$defs/paths"},
    "doc_extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}, "uniqueItems": true},
    "junk_globs": {"$ref": "#/$defs/some_paths"},
    "max_lines": {"$ref": "#/$defs/per_extension"},
    "max_function_lines": {"$ref": "#/$defs/per_extension"},
    "header_comment_extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}, "uniqueItems": true},
    "mapped_roots": {"$ref": "#/$defs/some_paths"},
    "map_file": {"type": "string", "minLength": 1},
    "map_markers": {"type": "array", "minItems": 2, "items": false, "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "minLength": 1}]},
    "claude_md_max_lines": {"type": "integer", "minimum": 1},
    "cpp_layers": {"type": "object", "additional": {"$ref": "#/$defs/some_paths"}},
    "forbidden": {
      "type": "array", "minItems": 1, "unique_key": "id",
      "items": {
        "type": "object", "strict": true,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "paths": {"$ref": "#/$defs/some_paths"},
          "pattern": {"type": "string", "minLength": 1},
          "except": {"$ref": "#/$defs/some_paths"},
          "message": {"type": "string", "minLength": 1},
          "_except_doc": {"$ref": "#/$defs/doc"}
        },
        "required": ["id", "paths", "pattern", "message"]
      }
    },
    "schemas": {"type": "object", "additional": {"type": "string", "pattern": "^tools/gates/schemas/[a-z0-9_]+\\.schema\\.json$"}},
    "magic_numbers": {
      "type": "object", "strict": true,
      "properties": {
        "paths": {"$ref": "#/$defs/some_paths"},
        "exempt": {"$ref": "#/$defs/paths"},
        "extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}, "uniqueItems": true},
        "allowed_values": {"type": "array", "minItems": 1, "items": {"type": "number"}, "uniqueItems": true},
        "data_copy_paths": {"$ref": "#/$defs/some_paths"},
        "_data_copy_doc": {"$ref": "#/$defs/doc"}
      },
      "required": ["paths", "exempt", "extensions", "allowed_values", "data_copy_paths"]
    },
    "clones": {
      "type": "object", "strict": true,
      "properties": {
        "min_tokens": {"type": "integer", "minimum": 1},
        "paths": {"$ref": "#/$defs/some_paths"},
        "extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}, "uniqueItems": true}
      },
      "required": ["min_tokens", "paths", "extensions"]
    },
    "lab_reference": {
      "type": "object", "strict": true,
      "properties": {
        "_doc": {"$ref": "#/$defs/doc"},
        "place": {"type": "string", "minLength": 1},
        "dirs": {"$ref": "#/$defs/paths"},
        "skip_dirs": {"$ref": "#/$defs/paths"},
        "base": {"$ref": "#/$defs/paths"}
      },
      "required": ["place", "dirs", "skip_dirs", "base"]
    },
    "lab_copy": {
      "type": "object", "strict": true,
      "properties": {
        "_doc": {"$ref": "#/$defs/doc"},
        "paths": {"$ref": "#/$defs/some_paths"},
        "extensions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.[a-z]+$"}, "uniqueItems": true},
        "k": {"type": "integer", "minimum": 2},
        "w": {"type": "integer", "minimum": 1},
        "min_name_len": {"type": "integer", "minimum": 1},
        "trivial_numbers": {"type": "array", "items": {"type": "number"}, "uniqueItems": true},
        "max_spread": {"type": "integer", "minimum": 1},
        "min_tokens": {"type": "integer", "minimum": 1},
        "min_share": {"type": "number", "minimum": 0, "maximum": 1},
        "min_numbers": {"type": "integer", "minimum": 2}
      },
      "required": ["paths", "extensions", "k", "w", "min_name_len", "trivial_numbers", "max_spread", "min_tokens", "min_share",
        "min_numbers"]
    },
    "states": {
      "type": "object", "strict": true,
      "description": "STATE_CONTROLLER (gate_states.py): every enum named like a state is a machine with its controller or a kind",
      "properties": {
        "_doc": {"$ref": "#/$defs/doc"},
        "paths": {"$ref": "#/$defs/some_paths"},
        "suffixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Za-z]*$"}, "uniqueItems": true},
        "machines": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "strict": true,
            "properties": {
              "enum": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
              "declared": {"type": "string", "minLength": 1},
              "file": {"type": "string", "minLength": 1},
              "member": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "setter": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
              "table": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "why": {"$ref": "#/$defs/doc"}
            },
            "required": ["enum", "declared", "file", "member", "setter"]
          }
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object", "strict": true,
            "properties": {
              "enum": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
              "declared": {"type": "string", "minLength": 1},
              "why": {"$ref": "#/$defs/doc"}
            },
            "required": ["enum", "declared", "why"]
          }
        }
      },
      "required": ["paths", "suffixes", "machines", "kinds"]
    },
    "patch": {
      "type": "object", "strict": true,
      "description": "NUMBER_MOVED (gate_patch.py): the watched numbers and where a cause is recorded",
      "properties": {
        "_doc": {"$ref": "#/$defs/doc"},
        "watched": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "strict": true,
            "properties": {
              "paths": {"$ref": "#/$defs/some_paths"},
              "kind": {"type": "string", "enum": ["gd_const", "json"]},
              "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
            },
            "required": ["paths", "kind"]
          }
        },
        "logs": {"$ref": "#/$defs/some_paths"},
        "ledgers": {"type": "string", "minLength": 1}
      },
      "required": ["watched", "logs", "ledgers"]
    },
    "mirrors": {
      "type": "array",
      "items": {
        "type": "object", "strict": true,
        "description": "a value written twice (a shader array size) checked against its C++ owner (gate_tuning.check_mirrors)",
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "headers": {"$ref": "#/$defs/some_paths"},
          "constant": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "pattern": {"type": "string", "minLength": 1}
        },
        "required": ["file", "headers", "constant", "pattern"]
      }
    },
    "generated": {
      "type": "array", "minItems": 1, "unique_key": "generator",
      "items": {
        "type": "object", "strict": true,
        "properties": {
          "generator": {"type": "string", "pattern": "^tools/.+\\.py$"},
          "inputs": {"$ref": "#/$defs/some_paths"},
          "outputs": {"$ref": "#/$defs/some_paths"}
        },
        "required": ["generator", "inputs", "outputs"]
      }
    },
    "styled_tables": {"$ref": "#/$defs/some_paths"},
    "material_tables": {"$ref": "#/$defs/some_paths"},
    "uniform_tables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "strict": true,
        "properties": {
          "table": {"type": "string", "pattern": "^project/data/.+\\.json$"},
          "path": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"},
          "shaders": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^res://.+\\.gdshader$"}, "uniqueItems": true}
        },
        "required": ["table", "path", "shaders"]
      }
    },
    "_styled_tables_doc": {"$ref": "#/$defs/doc"},
    "_material_tables_doc": {"$ref": "#/$defs/doc"},
    "_uniform_tables_doc": {"$ref": "#/$defs/doc"},
    "_generated_doc": {"$ref": "#/$defs/doc"}
  },
  "required": ["exclude_dirs", "root_allowed", "allowed_docs", "doc_exempt_names", "doc_extensions", "junk_globs", "max_lines", "max_function_lines",
    "header_comment_extensions", "mapped_roots", "map_file", "map_markers", "claude_md_max_lines", "cpp_layers", "forbidden", "schemas",
    "magic_numbers", "clones", "lab_reference", "lab_copy", "states", "patch", "mirrors", "generated", "styled_tables", "material_tables",
    "uniform_tables"]
}
