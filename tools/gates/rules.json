{
  "exclude_dirs": [
    ".git",
    ".godot",
    "native/godot-cpp",
    "native/build-linux",
    "native/build-win",
    "native/build-win-debug",
    "project/addons",
    "project/bin",
    "dist",
    "__pycache__",
    ".claude/worktrees",
    "tools/converter",
    "tools/converter-slice",
    "tools/oracle-4.0",
    "tools/process",
    "tools/ports",
    "log"
  ],
  "root_allowed": [
    "CLAUDE.md",
    ".claude",
    ".gitignore",
    "native",
    "project",
    "tools",
    "dist",
    "log"
  ],
  "allowed_docs": [
    "CLAUDE.md",
    ".claude/REGISTRO-GOAL.md"
  ],
  "doc_exempt_names": [
    "CMakeLists.txt"
  ],
  "doc_extensions": [
    ".md",
    ".txt",
    ".rst",
    ".adoc",
    ".docx",
    ".pdf",
    ".odt"
  ],
  "junk_globs": [
    "*.bak",
    "*.orig",
    "*.tmp",
    "*~",
    "*_old.*",
    "*_copy.*",
    "* copy*",
    "*.rej",
    "*.swp",
    "*.new"
  ],
  "max_lines": {
    ".cpp": 350,
    ".h": 250,
    ".gd": 250,
    ".gdshader": 260,
    ".glsl": 200,
    ".py": 300,
    ".json": 700,
    ".sh": 90,
    ".tscn": 400,
    ".csv": 600
  },
  "max_function_lines": {
    ".gd": 60,
    ".cpp": 90
  },
  "header_comment_extensions": [
    ".cpp",
    ".h",
    ".gd",
    ".gdshader",
    ".glsl",
    ".py",
    ".sh"
  ],
  "mapped_roots": [
    "native/src",
    "native/CMakeLists.txt",
    "native/toolchain-mingw.cmake",
    "project/game",
    "project/ui",
    "project/render",
    "project/data",
    "project/tests",
    "project/project.godot",
    "project/export_presets.cfg",
    "tools",
    "tools/gates/owners.json"
  ],
  "map_file": "log/mapa.md",
  "map_markers": [
    "<!-- MAPA:INICIO -->",
    "<!-- MAPA:FIM -->"
  ],
  "claude_md_max_lines": 200,
  "cpp_layers": {
    "native/src/core": [
      "core/"
    ],
    "native/src/sim/transit": [
      "core/",
      "sim/"
    ],
    "native/src/sim/catalog": [
      "core/",
      "sim/catalog/"
    ],
    "native/src/sim/state": [
      "core/",
      "sim/"
    ],
    "native/src/sim/terrain": [
      "core/",
      "sim/catalog/",
      "sim/state/change_log.h",
      "sim/terrain/"
    ],
    "native/src/sim/roads": [
      "core/",
      "sim/catalog/",
      "sim/state/change_log.h",
      "sim/roads/"
    ],
    "native/src/sim/street": [
      "core/",
      "sim/catalog/",
      "sim/state/change_log.h",
      "sim/roads/",
      "sim/street/"
    ],
    "native/src/sim/buildings": [
      "core/",
      "sim/catalog/",
      "sim/state/change_log.h",
      "sim/terrain/",
      "sim/roads/",
      "sim/buildings/"
    ],
    "native/src/sim/nature": [
      "core/",
      "sim/catalog/",
      "sim/state/change_log.h",
      "sim/terrain/",
      "sim/nature/"
    ],
    "native/src/sim/traffic": [
      "core/",
      "sim/catalog/",
      "sim/state/",
      "sim/roads/",
      "sim/buildings/",
      "sim/terrain/",
      "sim/street/",
      "sim/traffic/"
    ],
    "native/src/sim/economy": [
      "core/",
      "sim/"
    ],
    "native/src/sim/demolition": [
      "core/",
      "sim/"
    ],
    "native/src/sim/commands": [
      "core/",
      "sim/"
    ],
    "native/src/sim/simulation": [
      "core/",
      "sim/"
    ],
    "native/src/sim/persistence": [
      "core/",
      "sim/"
    ],
    "native/src/sim/citygen": [
      "core/",
      "sim/"
    ],
    "native/src/sim/lots": [
      "core/",
      "sim/citygen/",
      "sim/state/",
      "sim/lots/"
    ],
    "native/src/render": [
      "core/",
      "sim/",
      "render/",
      "godot_cpp/"
    ],
    "native/src/api": [
      "core/",
      "sim/",
      "render/",
      "api/",
      "godot_cpp/",
      "gdextension_interface.h"
    ]
  },
  "forbidden": [
    {
      "id": "JOB_SEM_CHAVE",
      "paths": [
        "native/src/"
      ],
      "pattern": "(jobs->|pool\\.)submit\\(\\s*(?!JobKey\\{|job,|b->job\\.bake\\(\\))",
      "message": "todo job vai à fila com uma JobKey (lane e id, core/job_pool.h): a fila substitui o job da mesma chave em silêncio, e uma chave feita à mão colide com a de outro renderizador"
    },
    {
      "id": "SIM_SEM_GODOT",
      "paths": [
        "native/src/core/",
        "native/src/sim/"
      ],
      "pattern": "#include\\s*<godot",
      "message": "core/ e sim/ são C++ puro (thread-safe, fonte única da verdade); Godot só em render/ e api/"
    },
    {
      "id": "RENDER_SO_LEITURA",
      "paths": [
        "native/src/render/"
      ],
      "pattern": "#include\\s*\"sim/commands/",
      "message": "render/ só lê o CityState; mutações só pela camada sim/commands"
    },
    {
      "id": "UM_DONO_DO_CORE",
      "paths": [
        "project/"
      ],
      "pattern": "\\bCityCore\\b",
      "except": [
        "project/game/store/city_store.gd"
      ],
      "message": "Só game/store/city_store.gd conversa com o núcleo C++ (CityCore)"
    },
    {
      "id": "FLUXO_CENTRAL",
      "paths": [
        "project/"
      ],
      "pattern": "change_scene_to|get_tree\\(\\)\\.paused\\s*=|get_tree\\(\\)\\.quit",
      "except": [
        "project/game/flow/game_flow.gd",
        "project/tests/"
      ],
      "message": "Troca de tela/pausa/saída só pelo GameFlow (game/flow/game_flow.gd)",
      "_except_doc": "Testes encerram o processo com o código de saída do resultado."
    },
    {
      "id": "UI_SEM_ESTILO_SOLTO",
      "paths": [
        "project/ui/",
        "project/game/"
      ],
      "pattern": "Color\\(|Color8\\(|\"#[0-9a-fA-F]{6}|add_theme_[a-z_]+_override",
      "except": [
        "project/ui/icons/",
        "project/ui/theme/theme_builder.gd"
      ],
      "message": "Cores/estilos só via design tokens (data/ui/tokens.json) aplicados por ui/theme/theme_builder.gd"
    },
    {
      "id": "TEXTO_VIA_TR",
      "paths": [
        "project/ui/",
        "project/game/"
      ],
      "pattern": "(\\.text|tooltip_text|\\.title)\\s*=\\s*\"[^\"]*[A-Za-zÀ-ú]{2}",
      "message": "Textos visíveis usam tr(\"CHAVE\") com data/i18n/strings.csv"
    },
    {
      "id": "DADOS_POR_UM_LEITOR",
      "paths": [
        "project/"
      ],
      "pattern": "res://data/[a-z_/]+\\.json",
      "except": [
        "project/game/data/data_tables.gd"
      ],
      "message": "JSON de dados só é lido por game/data/data_tables.gd"
    },
    {
      "id": "SEM_MARCADORES_SOLTOS",
      "paths": [
        "native/src/",
        "project/game/",
        "project/ui/",
        "project/render/",
        "project/tests/",
        "tools/"
      ],
      "pattern": "\\b(TODO|FIXME|XXX|HACK)\\b",
      "except": [
        "tools/gates/rules.json"
      ],
      "message": "Pendências vão para log/pendencias.md, não para comentários"
    },
    {
      "id": "MACHINE_PATH",
      "paths": [
        "tools/",
        "project/",
        "native/"
      ],
      "pattern": "(?i)\\b[a-z]:[\\\\/]users[\\\\/]|(?<![\\w.])/home/[a-z_][a-z0-9_.-]*/",
      "message": "a home folder of one machine (a person's name) in a tracked file: tools are found by tools/tasks/locations.py (the environment, the machine's tools/tasks/local.json, the PATH), and nothing else names a machine's folders"
    }
  ],
  "schemas": {
    "project/data/catalog/tuning.json": "tools/gates/schemas/tuning.schema.json",
    "project/data/render/models.json": "tools/gates/schemas/models.schema.json",
    "project/data/catalog/maps.json": "tools/gates/schemas/maps.schema.json",
    "project/data/catalog/nature.json": "tools/gates/schemas/nature.schema.json",
    "project/data/game/sky.json": "tools/gates/schemas/sky.schema.json",
    "project/data/render/cover.json": "tools/gates/schemas/cover.schema.json",
    "project/data/ui/land_panels.json": "tools/gates/schemas/land_panels.schema.json",
    "project/data/ui/land_elements.json": "tools/gates/schemas/land_elements.schema.json",
    "project/data/catalog/zones.json": "tools/gates/schemas/zones.schema.json",
    "project/data/catalog/growth.json": "tools/gates/schemas/growth.schema.json",
    "project/data/catalog/road_profiles.json": "tools/gates/schemas/road_profiles.schema.json",
    "project/data/catalog/road_profiles_a.json": "tools/gates/schemas/road_profiles_fragment.schema.json",
    "project/data/catalog/road_profiles_b.json": "tools/gates/schemas/road_profiles_fragment.schema.json",
    "project/data/catalog/traffic.json": "tools/gates/schemas/traffic.schema.json",
    "project/data/catalog/street_furniture.json": "tools/gates/schemas/street_furniture.schema.json",
    "project/data/catalog/blast.json": "tools/gates/schemas/blast.schema.json",
    "project/data/render/agents.json": "tools/gates/schemas/agents.schema.json",
    "project/data/render/transit.json": "tools/gates/schemas/transit.schema.json",
    "project/data/render/effects.json": "tools/gates/schemas/effects.schema.json",
    "project/data/render/buildings.json": "tools/gates/schemas/buildings.schema.json",
    "project/data/render/interiors.json": "tools/gates/schemas/interiors.schema.json",
    "project/data/render/furniture.json": "tools/gates/schemas/furniture.schema.json",
    "project/data/game/interior.json": "tools/gates/schemas/interior.schema.json",
    "project/data/render/materials.json": "tools/gates/schemas/materials.schema.json",
    "project/data/render/streets.json": "tools/gates/schemas/streets.schema.json",
    "project/data/render/palette.json": "tools/gates/schemas/palette.schema.json",
    "project/data/ui/tokens.json": "tools/gates/schemas/tokens.schema.json",
    "project/data/ui/builder.json": "tools/gates/schemas/builder.schema.json",
    "project/data/ui/hud.json": "tools/gates/schemas/hud.schema.json",
    "project/data/ui/drawers.json": "tools/gates/schemas/drawers.schema.json",
    "project/data/game/camera.json": "tools/gates/schemas/camera.schema.json",
    "project/data/game/settings.json": "tools/gates/schemas/settings.schema.json",
    "project/data/game/daylight.json": "tools/gates/schemas/daylight.schema.json",
    "project/data/game/saves.json": "tools/gates/schemas/saves.schema.json",
    "project/data/game/render_switches.json": "tools/gates/schemas/render_switches.schema.json",
    "project/data/game/optimizations.json": "tools/gates/schemas/optimizations.schema.json",
    "project/data/game/health.json": "tools/gates/schemas/health.schema.json",
    "project/data/game/start.json": "tools/gates/schemas/start.schema.json",
    "project/data/game/lab.json": "tools/gates/schemas/lab.schema.json",
    "project/data/ui/keys.json": "tools/gates/schemas/keys.schema.json",
    "project/data/ui/help.json": "tools/gates/schemas/help.schema.json",
    "project/data/render/overlays.json": "tools/gates/schemas/overlays.schema.json",
    "project/data/render/bay_props.json": "tools/gates/schemas/bay_props.schema.json",
    "tools/gates/rules.json": "tools/gates/schemas/rules.schema.json",
    "tools/gates/lexicon.json": "tools/gates/schemas/lexicon.schema.json"
  },
  "magic_numbers": {
    "paths": [
      "native/src/",
      "project/game/",
      "project/ui/"
    ],
    "exempt": [
      "native/src/core/",
      "native/src/api/catalog_loader.cpp"
    ],
    "extensions": [
      ".cpp",
      ".h",
      ".gd"
    ],
    "allowed_values": [
      0,
      1,
      2,
      3,
      4,
      -1,
      0.5,
      0.25,
      1.5
    ],
    "data_copy_paths": [
      "native/src/",
      "project/game/",
      "project/ui/",
      "project/render/"
    ],
    "_data_copy_doc": "Tables a generator writes (generated outputs) are no owner of their values: their generator's inputs are. A constant is a second owner of a data key when its name equals the key's word for word with two or more words, or its name matches the key and it is declared with that key's own value (gate_defs.check_data_copies); there is no list of exceptions: a constant that is no copy is named for what it is."
  },
  "clones": {
    "min_tokens": 80,
    "paths": [
      "native/src/",
      "project/game/",
      "project/ui/",
      "project/render/",
      "tools/"
    ],
    "extensions": [
      ".cpp",
      ".h",
      ".gd",
      ".gdshader",
      ".py"
    ]
  },
  "mirrors": [],
  "generated": [
    {
      "generator": "tools/assets/make_furniture.py",
      "inputs": [
        "project/data/render/interiors.json"
      ],
      "outputs": [
        "project/data/render/furniture.json"
      ]
    }
  ],
  "styled_tables": [
    "project/data/catalog/street_furniture.json",
    "project/data/render/streets.json"
  ],
  "_styled_tables_doc": "Tables read with a regional style laid over them (DataTables.STYLED): the data gate lays each style over the table and judges the result by the table's own schema.",
  "material_tables": [
    "project/data/render/materials.json"
  ],
  "_material_tables_doc": "Tables of materials whose params are set on their shader by name: each param is a uniform of that shader (gate_materials.py).",
  "uniform_tables": [
    {
      "table": "project/data/render/palette.json",
      "path": "terrain",
      "shaders": [
        "res://render/shaders/terrain.gdshader"
      ]
    }
  ],
  "_uniform_tables_doc": "Blocks of a table set key by key on shaders (render/city_world.gd _build_terrain sets palette.terrain on the terrain's and the verge's): each key a uniform of the listed shaders.",
  "_generated_doc": "Files a generator writes: the generator's --check (exit 0 when the outputs on disk are what it writes, writing nothing) must pass, so a hand edit of an output cannot stand."
}
