{
 "rule": "map",
 "expect": [
  "CLAUDE_MD CLAUDE.md",
  "MAPA_DESATUALIZADO log/mapa.md",
  "MAPA_DESATUALIZADO tools/b.py"
 ],
 "overrides": {
  "mapped_roots": [
   "tools"
  ],
  "map_file": "log/mapa.md",
  "map_markers": [
   "<!-- MAP:START -->",
   "<!-- MAP:END -->"
  ],
  "claude_md_max_lines": 2
 }
}
