      "scope": ["native/src/", "project/render/"]
    },
    {
      "id": "money_format",
      "owner": "project/game/store/formatters.gd",
      "symbol": "format_money",
      "forbidden_elsewhere": ["\"\\$\"\\s*\\+", "%\\.2f", "R\\$"],
