      "scope": ["native/src/", "project/game/", "project/ui/", "project/render/"]
    },
    {
      "id": "floor_height",
      "owner": "native/src/render/buildings/b40_types.h",
      "symbol": "level_h",
      "forbidden_elsewhere": ["\\.floor_h\\b"],
      "allow": ["native/src/sim/catalog/", "native/src/api/catalog_loader.cpp"],
      "scope": ["native/src/"]
    },
    {
      "id": "lot_rule",
      "owner": "native/src/sim/citygen/lot_gen.cpp",
      "symbol": "LotStrips::lot_free",
      "forbidden_elsewhere": ["\\.building\\s*<\\s*0", "building\\s*==\\s*-1"],
      "allow": ["native/src/sim/zones/zone_grid.cpp", "native/src/sim/zones/zone_grid.h"],
      "scope": ["native/src/"]
    },
    {
