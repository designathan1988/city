{
 "_doc": "Viaduto do 4.0: via a 5,6 m por setRoadHeight, a local passando por baixo, nas poses de capture_structures.",
 "viewport": [
  1600,
  900
 ],
 "city": {
  "size": "small",
  "seed": 7
 },
 "steps": [
  {
   "wait": 1500
  },
  {
   "press": "Começar a construir"
  },
  {
   "until": "(() => !document.querySelector('.v2-start'))()",
   "name": "title closed",
   "timeout": 60000,
   "polling": 250
  },
  {
   "eval": "window.__roadcraft.sim.setClock(720); window.__roadcraft.scene && window.__roadcraft.scene().setSkyMode('day'); const r = window.__roadcraft; const all = [...r.doc.nodes.values()]; const ty = (n) => (n.incident ?? []).map((s) => r.doc.segment(s).type); window.__far = Math.max(...all.map((n) => n.x)) + 260; window.__v = (n, zoom, az, el) => { r.setView({ x: n.x, y: n.y, zoom, azimuth: az * Math.PI / 180, elevation: el * Math.PI / 180 }); return [n.id, n.x, n.y, (n.incident ?? []).length, ty(n)]; }; window.__n0 = Math.max(...all.map((n) => n.id)); window.__mine = () => [...r.doc.nodes.values()].filter((n) => n.id > window.__n0); window.__ty = ty; const loc = all.sort((a, b) => Math.hypot(a.x, a.y) - Math.hypot(b.x, b.y)).find((n) => n.incident.length === 4 && Math.max(...ty(n)) <= 1); window.__loc = loc; loc.id"
  },
  {
   "eval": "document.querySelector('[data-cat=roads]').click(); 1"
  },
  {
   "wait": 900
  },
  {
   "eval": "window.__v({ x: window.__far, y: 0 }, 2.2, 0, 70)"
  },
  {
   "wait": 3500
  },
  {
   "eval": "const c=[...document.querySelectorAll('.rc-card-main')]; c[0].click(); String(c.length)"
  },
  {
   "wait": 600
  },
  {
   "eval": "window.__roadcraft.setRoadHeight(5.6);1"
  },
  {
   "wait": 300
  },
  {
   "click": [
    420,
    220
   ]
  },
  {
   "wait": 300
  },
  {
   "move": [
    980,
    220
   ]
  },
  {
   "wait": 500
  },
  {
   "click": [
    980,
    220
   ]
  },
  {
   "wait": 2500
  },
  {
   "eval": "document.querySelector('[data-cat=roads]').click(); 1"
  },
  {
   "wait": 800
  },
  {
   "eval": "document.querySelector('[data-cat=roads]').click(); 1"
  },
  {
   "wait": 800
  },
  {
   "eval": "window.__c1 = window.__mine().length; const m=window.__mine(); window.__h={x:(m[0].x+m[m.length-1].x)/2,y:(m[0].y+m[m.length-1].y)/2,incident:[]}; JSON.stringify([m.length,m[0].x,m[0].y,m[m.length-1].x,m[m.length-1].y])"
  },
  {
   "eval": "const c=[...document.querySelectorAll('.rc-card-main')]; c[0].click(); String(c.length)"
  },
  {
   "wait": 600
  },
  {
   "eval": "window.__roadcraft.setRoadHeight(0);1"
  },
  {
   "wait": 300
  },
  {
   "click": [
    700,
    110
   ]
  },
  {
   "wait": 300
  },
  {
   "move": [
    700,
    340
   ]
  },
  {
   "wait": 500
  },
  {
   "click": [
    700,
    340
   ]
  },
  {
   "wait": 2500
  },
  {
   "eval": "document.querySelector('[data-cat=roads]').click(); 1"
  },
  {
   "wait": 800
  },
  {
   "eval": "window.__roadcraft.setTraffic(false);window.__v(window.__h,16,30,18)"
  },
  {
   "wait": 5000
  },
  {
   "shot": "viaduto-low"
  },
  {
   "eval": "window.__v(window.__h,10,20,62)"
  },
  {
   "wait": 3500
  },
  {
   "shot": "viaduto-top"
  },
  {
   "eval": "window.__v(window.__h,12,0,6)"
  },
  {
   "wait": 3500
  },
  {
   "shot": "viaduto-side"
  }
 ]
}