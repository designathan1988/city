  "size": "small",
  "seed": 7
 },
 "steps": [
  {
   "wait": 1500
  },
  {
   "press": "Começar a construir"
  },
  {
   "until": "(() => { const b = [...document.querySelectorAll('button')].find((e) => e.textContent.trim() === 'Começar a construir'); return !b || b.getBoundingClientRect().width === 0 || getComputedStyle(b).visibility === 'hidden'; })()",
   "name": "menu closed",
   "timeout": 30000,
   "polling": 250
  },
  {
   "setView": [
    3000,
    0,
    30,
    45,
    4
   ]
  },
  {
   "wait": 700
  },
  {
   "eval": "(()=>{const v=window.__roadcraft.view();const o={};for(const k of ['zoom','azimuth','elevation','perspective'])try{o[k]=v[k]}catch(e){}const c=v.camera||(v.rig&&v.rig.camera);if(c){o.pos=c.position.toArray();o.q=c.quaternion.toArray();o.fov=c.fov;o.top=c.top;o.ortho=!!c.isOrthographicCamera}o.keys=Object.keys(v).slice(0,24);return JSON.stringify(o)})()"
