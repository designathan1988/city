const float PROP_NIGHT_GLOW = 2.0;
const float PROP_LENS = 3.0;
const float PROP_WIRE = 4.0;
const float PROP_WOOD = 5.0;
const float PROP_PLATE = 6.0;
const float PROP_FINISHED = 7.0;
