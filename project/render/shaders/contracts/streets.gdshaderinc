const int ROAD_TONE_SLOTS = 8;
// a road vertex's material, in its colour's alpha times ROAD_MAT_SCALE (road_look.h; road_body.gdshaderinc)
const int ROAD_MAT_ASPHALT = 0;
const int ROAD_MAT_PLATE = 1;
const int ROAD_MAT_FOOTWAY = 2;
