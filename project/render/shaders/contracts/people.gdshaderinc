// What the shaders share with the C++ core and the scripts: the people: their clip and body tables, face acts, helmets and the cooked asset's layout (render/agents people_*; the people shaders). Generated by tools/build/shader_contracts.py from tools/build/shader_contracts.json: edit the table, never this file.
#ifndef CONTRACTS_PEOPLE_INCLUDED
#define CONTRACTS_PEOPLE_INCLUDED

// the clips a person's tables hold (people_boot.cpp CLIP_TABLE; people_pose.gdshaderinc clip_row, clip_frames, clip_seconds by sex; people_face.gdshaderinc act_face)
const int PEOPLE_CLIPS = 64;
// the body variations (people_boot.cpp BODY_TABLE; people_face body_mood; three rows each in palm_rows and helmet_rows)
const int PEOPLE_BODIES = 32;
// rows a variation takes in palm_rows and helmet_rows (people_boot.cpp PALM_ROWS)
const int PEOPLE_HAND_ROWS = 3;
// what a face does at a clip (people_boot.cpp FACE_ACTS, people_face.gdshaderinc)
const int FACE_ACT_TALK = 1;
// as FACE_ACT_TALK
const int FACE_ACT_LISTEN = 2;
// as FACE_ACT_TALK
const int FACE_ACT_PHONE = 3;
// as FACE_ACT_TALK
const int FACE_ACT_CROUCH = 4;
// the helmets' colours (helmets.cpp, people_helmet.gdshader)
const int HELMET_COLOURS = 8;
// the cooked people (people_asset.cpp reads and checks them): a face row's channels and the rows side by side in face_table (people_face.gdshaderinc), a bone's texels in the palette and a value's (high bytes, then low; people_pose.gdshaderinc), the skeleton's bones (people_skin.gdshaderinc), the clips a figure's pose blends: a row of the plays texture each (people_gait.cpp writes them, people_pose.gdshaderinc reads them: clip, phase, weight; the lab's citizenRow and GPU_PLAYS)
const int PEOPLE_FACE_CHANNELS = 13;
const int PEOPLE_FACE_SPAN = 8;
const int PEOPLE_BONE_TEXELS = 3;
const int PEOPLE_PALETTE_TEXELS = 2;
const int PEOPLE_BONES = 53;
const int PEOPLE_PLAYS = 8;
// a face vertex's UV2.x is its region plus this many a row of face_table; a palette value is fixed point over [-span, span] (people_asset.cpp; people_face.gdshaderinc, people_pose.gdshaderinc)
const float PEOPLE_FACE_ROW_STEP = 4.0;
const float PEOPLE_PALETTE_SPAN = 3.0;

#endif
