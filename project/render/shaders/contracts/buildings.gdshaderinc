// What the shaders share with the C++ core and the scripts: the buildings: surface kinds and their bits, finishes, panes, bays, sills, cards, condensers and ruins (render/buildings, render/effects ruin_pieces, b40/types.h; the building shaders). Generated by tools/build/shader_contracts.py from tools/build/shader_contracts.json: edit the table, never this file.
#ifndef CONTRACTS_BUILDINGS_INCLUDED
#define CONTRACTS_BUILDINGS_INCLUDED

// what a building face is, in its vertex colour's alpha, under SURFACE_KIND_BITS (shell.h; the building shaders). SK_GROUND: a shell face lying on the lot, which stays on it when a level steps back
const int SK_SHELL = 0;
const int SK_PANE = 1;
const int SK_PANE_DARK = 2;
const int SK_FAR_WALL = 3;
const int SK_LAMP = 4;
const int SK_LAWN = 5;
const int SK_PANE_CLEAR = 6;
const int SK_GROUND = 7;
const int SK_COUNT = 8;
// the low bits of a vertex colour's alpha byte a SurfaceKind takes; above them a pane's recess (shell.cpp) or the far level's chunk (building_renderer_build.cpp; building_glass_body.gdshaderinc, building_far.gdshader)
const int SURFACE_KIND_BITS = 3;
// the far level's alpha byte's top bit: its rooms take the office lamps (building_renderer_build.cpp, building_far.gdshader)
const int FAR_OFFICE_BIT = 128;
// the roughness of a building face with no finish (building_body.gdshaderinc, building_parts_body.gdshaderinc) and of the far level's (building_far.gdshader); building_light_test holds the engine's own material to them
const float BUILDING_WALL_ROUGHNESS = 0.86;
const float BUILDING_FAR_ROUGHNESS = 0.9;
// a far wall's window flags byte (far_mass.cpp writes, building_far.gdshader and building_far_window.gdshaderinc read): a side with no openings, an office's, and from the shift on a PaneDark in its bits
const int WINDOW_FLAG_BLANK = 4;
const int WINDOW_FLAG_OFFICE = 8;
const int WINDOW_DARK_SHIFT = 4;
const int WINDOW_DARK_BITS = 2;
// how a bay's component picks its dark panes (facade_bay.h pane_dark; building_far_window.gdshaderinc)
const int PANE_DARK_PICK = 0;
const int PANE_DARK_NONE = 1;
const int PANE_DARK_QUARTER = 2;
const int PANE_DARK_FIFTH = 3;
const int PANE_DARK_COUNT = 4;
// what a card draws, in its UV2.x (shell.h; building_card.gdshader)
const int CARD_ROOF_RAILING = 2;
const int CARD_RAILING_FRONT = 3;
const int CARD_RAILING_SIDE = 4;
const int CARD_BRISE = 5;
// what a face of the shared bay mesh is, in its UV.x (bay_kit.cpp; building_bay.gdshaderinc)
const int BAY_PIECE_WALL = 0;
const int BAY_PIECE_REVEAL = 1;
const int BAY_PIECE_PANE = 2;
const int BAY_PIECE_SILL = 3;
// the bay mesh's UV2.y: the vertex stage places it from the instance (bay_kit.cpp; building_body.gdshaderinc reads over it by a half)
const float BAY_MESH_MARK = 2.0;
// the lines of the bay mesh by name, in its index space, which keeps the real lines' order (bay_kit.cpp lays them; building_bay.gdshaderinc reads each name up to halfway to the next)
const float BAY_X_LEFT = 0.0;
const float BAY_X_SILL_LEFT = 0.5;
const float BAY_X_JAMB_LEFT = 1.0;
const float BAY_X_JAMB_RIGHT = 2.0;
const float BAY_X_SILL_RIGHT = 2.5;
const float BAY_X_RIGHT = 3.0;
const float BAY_Y_FOOT = 0.0;
const float BAY_Y_UNDER_SILL = 0.5;
const float BAY_Y_SILL = 1.0;
const float BAY_Y_HEAD = 2.0;
const float BAY_Y_TOP = 3.0;
const float BAY_Z_PANE = -1.0;
const float BAY_Z_WALL = 0.0;
const float BAY_Z_SILL = 1.0;
// a bay instance's code: the seed byte, the finish + 1, the window flags byte, the depth steps (shell.cpp Shell::bay; building_bay.gdshaderinc)
const int BAY_FIN_SHIFT = 8;
const int BAY_FLAGS_SHIFT = 12;
const int BAY_DEPTH_SHIFT = 20;
// a byte's 1.0 of a room's depth behind a pane, metres (shell.h, building_pane.gdshaderinc)
const float ROOM_SPAN_M = 12.75;
// a byte's 1.0 of a frame's thickness, metres (shell.h, building_pane.gdshaderinc)
const float FRAME_SPAN_M = 0.255;
// a step of a pane's recess in its colour's alpha above the kind (shell.cpp, building_glass_body.gdshaderinc)
const float PANE_RECESS_STEP_M = 0.01;
// a step of a bay's depth (shell.cpp, building_bay.gdshaderinc)
const float BAY_DEPTH_STEP_M = 0.04;
// how much longer a sill is than its opening, both sides together (facade_parts.cpp; building_bay.gdshaderinc takes half each side)
const float SILL_PAST_M = 0.14;
// a sill's thickness (facade_parts.cpp, building_bay.gdshaderinc)
const float SILL_T_M = 0.06;
// how far a sill stands out of the wall (facade_parts.cpp, building_bay.gdshaderinc)
const float SILL_OUT_M = 0.07;
// the shade of an opening's sides (facade_bay.cpp, building_pane.gdshaderinc)
const float REVEAL_SHADE = 0.68;
// the shade of a sill, of the trim (facade_bay.cpp, building_pane.gdshaderinc)
const float SILL_SHADE = 0.92;
// the shade of an opening's head, of its sides' (facade_bay.cpp; building_pane.gdshaderinc multiplies it by REVEAL_SHADE)
const float HEAD_SHADE = 0.8;
// the fins of a brise-soleil card (part_models.cpp; building_card.gdshader's pitch is one over this)
const int BRISE_FINS = 6;
// a railing in shares of its box, as boxes near and as a card's bars past them (part_models.cpp; building_card.gdshader): the lab's balcony railing (render/buildings/kit.ts railingGeometry): the top rail's middle, height and depth, the low rail's, a baluster's side and height; a roof railing's mid rail, its posts' pitch and width
const float RAIL_TOP_AT = 0.97;
const float RAIL_TOP_H = 0.06;
const float RAIL_TOP_D = 0.05;
const float RAIL_LOW_AT = 0.12;
const float RAIL_LOW_H = 0.04;
const float RAIL_LOW_D = 0.03;
const float RAIL_BAR = 0.015;
const float RAIL_BAR_H = 0.94;
const float ROOF_RAIL_MID_AT = 0.45;
const float ROOF_RAIL_POSTS = 0.25;
const float ROOF_RAIL_POST_W = 0.02;
// the gaps between a balcony railing's balusters, in front and on a side (kit.ts railingGeometry: eleven in front, three a side between the corner and the wall)
const int RAIL_FRONT_BARS = 10;
const int RAIL_SIDE_BARS = 4;
// the vertex colour alpha of the condenser case's front, which building_props.gdshader draws (bay_props.cpp; every other part 1)
const float BAY_PROP_FRONT_MARK = 0.0;
// pieces a row of a ruin's matrix texture (ruin_pieces.cpp, building_body.gdshaderinc)
const int RUIN_PIECES_A_ROW = 256;
// a building finish, in the cooked texture array's layer order (project/assets/surfaces/building-finishes.*.png; b40/types.h; the building shaders' finish_m, finish_normal_k, finish_metal by layer, and the finishes they leave unweathered)
const int FIN_NONE = -1;
const int FIN_PLASTER = 0;
const int FIN_STUCCO = 1;
const int FIN_CERAMIC = 2;
const int FIN_BRICK = 3;
const int FIN_STONE = 4;
const int FIN_CONCRETE = 5;
const int FIN_WOOD = 6;
const int FIN_METAL = 7;
const int FIN_GLASS = 8;
const int FIN_TILE = 9;
const int FIN_SLATE = 10;
const int FIN_PANEL = 11;
const int FIN_ROOFING = 12;
const int FIN_COUNT = 13;

#endif
