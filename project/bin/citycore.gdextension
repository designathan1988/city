[configuration]

entry_symbol = "citycore_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libcitycore.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libcitycore.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libcitycore.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcitycore.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/libcitycore.android.template_release.arm64.so"
android.release.arm64 = "res://bin/libcitycore.android.template_release.arm64.so"
