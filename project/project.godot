; Engine configuration. Gameplay data lives in res://data (see CLAUDE.md).
config_version=5

[application]

config/name="Roadcraft"
run/main_scene="res://game/play.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://game/settings/settings.gd"
CityStore="*res://game/store/city_store.gd"
GameFlow="*res://game/flow/game_flow.gd"
Health="*res://game/health/health_log.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[gui]

timers/tooltip_delay_sec=3600.0

[rendering]
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=0

[shader_globals]

lamp_lit={
"type": "vec2",
"value": Vector2(0, 0)
}
building_recess={
"type": "float",
"value": 1.0
}
sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
road_paint={
"type": "float",
"value": 1.0
}
building_glass={
"type": "float",
"value": 1.0
}
building_night_windows={
"type": "float",
"value": 1.0
}
