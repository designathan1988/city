{
  "feature": "yard",
  "subsystem": "native/src/sim/yard",
  "namespace": "city",
  "source": "src/world/yard.ts",
  "summary": "A fixture yard of posts",
  "state": {
    "source": "YardData",
    "target": "YardState",
    "member": "yard",
    "root": "native/src/sim/state/city_state.h",
    "empty": "emptyYard"
  },
  "units": [
    "addPost",
    "removePost",
    "countNear",
    "nearest",
    "firstX",
    "chain",
    "limited",
    "postById",
    "median",
    "slope",
    "keptCount",
    "keptBoth",
    "summed",
    "shortLabel",
    "heightHash",
    "litHeight",
    "placesAndIds",
    "TURN",
    "kindCost",
    "checkedCount",
    "idOrder",
    "priceOf",
  "tallied",
  "chainSum",
    "shelved",
    "mixed",
    "legsOf"
  ],
  "pending": [],
  "number": "float",
  "functions": {
    "lookOf": {
      "template": "post_look($0)",
      "include": "core/look.h",
      "reason": "the fixture target owns how a post looks"
    }
  },
  "classes": {},
  "memoizers": [
    "identityMemo"
  ],
  "patterns": [
    {
      "source": "($x + 32768) * 65536 + ($y + 32768)",
      "target": "cell_key($x, $y)",
      "include": "core/grid.h",
      "reason": "the target's cell keys"
    }
  ],
  "typeNames": {
    "{ i: number; d: number; at: Vec2; }": "Nearest"
  },
  "layer": {
    "rules": "tools/gates/rules.json",
    "includes": [
      "core/",
      "sim/yard/"
    ]
  },
  "types": {
    "PostLook": {
      "type": "PostLookC",
      "include": "core/look.h",
      "fields": {
        "height": "height",
        "lit": "lit"
      }
    }
  }
}
