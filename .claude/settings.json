{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Agent",
      "Workflow",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Edit(tools/gates/rules.json)",
      "Edit(tools/gates/owners.json)",
      "Edit(tools/gates/run_gates.py)",
      "Edit(tools/gates/gate_*.py)",
      "Edit(tools/gates/hook_*.py)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/gates/hook_protect.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/gates/hook_stop_gates.py"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
