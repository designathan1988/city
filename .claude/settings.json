{
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
            "args": [
              "C:/Projects/Roadcraft-windows/ferramentas/hook_regras.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Jonathan/AppData/Local/Programs/Python/Python312/python.exe",
            "args": [
              "C:/Projects/Roadcraft-windows/ferramentas/hook_regras.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
