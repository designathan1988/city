{
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Skill",
      "ToolSearch",
      "mcp__plugin_context7_context7__*"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/port_state.py\" hook",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/port_state.py\" hook",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/port_state.py\" hook",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
