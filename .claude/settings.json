{
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/tools/gates/tests/fixtures/**/CLAUDE.md"
  ],
  "permissions": {
    "deny": [
      "Agent",
      "Read(~/.claude/projects/*/*.jsonl)",
      "Read(~/.claude/projects/*/*/tool-results/**)",
      "Read(~/.claude/projects/*/*/subagents/**)",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__export_transcript"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block_guard.py"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive_guard.py"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
