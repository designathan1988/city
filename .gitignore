.godot/
native/build-*/
project/bin/*.so
# The core's Windows DLLs are versioned (a clone opens in Godot without building): rebuilt with every C++ change
project/bin/*.dll
!project/bin/libcitycore.windows.template_release.x86_64.dll
!project/bin/libcitycore.windows.template_debug.x86_64.dll
dist/
__pycache__/
*.tmp
# .claude/: only the project's settings, hooks, skills and agents are versioned; everything else there is the sessions' runtime
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
!/.claude/agents/
# the trace-fix hooks' own failures, kept beside the skill for whoever reads them: this machine's, never committed
/.claude/skills/trace-fix/read_guard_errors.txt
*.translation
# Where this machine's tools are (tools/tasks/locations.py): the machine's own, never committed
tools/tasks/local.json
