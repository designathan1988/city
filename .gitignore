.godot/
native/build-*/
project/bin/*.so
# The core's Windows DLLs are versioned (a clone opens in Godot without building): rebuilt with every C++ change
project/bin/*.dll
!project/bin/libcitycore.windows.template_release.x86_64.dll
!project/bin/libcitycore.windows.template_debug.x86_64.dll
dist/
__pycache__/
*.pyc
.venv/
*.tmp
# Editors' and systems' own files (Spec Kit's setup check, speckit-implement step 4)
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
# .claude/: only the project's settings, hooks, agents, skills and rules are versioned; everything else there is the sessions' runtime
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/agents/
!/.claude/skills/
!/.claude/rules/
*.translation
# Where this machine's tools are (tools/tasks/locations.py): the machine's own, never committed
tools/tasks/local.json
# The feature tracer's runtime: its saved analyses, the TypeScript compiler it installs (npm ci in tools/tracer/tracer/tools),
# what its bench writes
tools/tracer/.index/
tools/tracer/tracer/tools/node_modules/
tools/tracer/bench/out/
tools/tracer/bench/baseline/*.oracle.jsonl
