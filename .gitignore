.godot/
native/build-*/
project/bin/*.so
# The core's Windows DLLs are versioned (a clone opens in Godot without building): rebuilt with every C++ change
project/bin/*.dll
!project/bin/libcitycore.windows.template_release.x86_64.dll
!project/bin/libcitycore.windows.template_debug.x86_64.dll
dist/
__pycache__/
*.tmp
.claude/worktrees/
*.translation
# The tools: the converter's worktree is pushed as its branch; the instrumented 4.0's sessions, caches and token file stay out
tools/converter-slice/
tools/oracle-4.0/.claude/
tools/oracle-4.0/.cache/
tools/oracle-4.0/.vite-oracle-cache/
tools/oracle-4.0/.playwright-mcp/
tools/oracle-4.0/node_modules
tools/oracle-4.0/.mcp.json
